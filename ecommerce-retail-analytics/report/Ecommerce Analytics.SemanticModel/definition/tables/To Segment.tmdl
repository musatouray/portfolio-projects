/// BUSINESS MEANING: Disconnected helper dimension listing the RFM segments, used as the destination (current-snapshot) axis of the segment-migration Sankey and heatmap. GRAIN: one row per RFM segment. RELATIONSHIPS: none (disconnected; the Transition measures read it via SELECTEDVALUE).
table 'To Segment'
	lineageTag: f2a20001-0001-4001-8001-000000000001

	/// RFM segment acting as the destination (current-snapshot) segment in migration analysis. Grain: one per RFM segment.
	column 'To Segment'
		lineageTag: f2a20001-0001-4001-8001-000000000002
		summarizeBy: none
		isNameInferred
		sourceColumn: [To Segment]
		sortByColumn: 'To Index'

		annotation SummarizationSetBy = Automatic

	/// Sort order of the destination segment. Grain: per segment.
	column 'To Index'
		isHidden
		lineageTag: f2a20001-0001-4001-8001-000000000003
		summarizeBy: none
		isNameInferred
		sourceColumn: [To Index]

		annotation SummarizationSetBy = Automatic

	partition 'To Segment' = calculated
		mode: import
		source =
				DISTINCT (
				    SELECTCOLUMNS (
				        FCT_RFM_SEGMENTS,
				        "To Segment", FCT_RFM_SEGMENTS[RFM_SEGMENT],
				        "To Index", FCT_RFM_SEGMENTS[SEGMENT_INDEX]
				    )
				)

	annotation PBI_Id = b2f0c2d34e5f4a6b8c9d0e1f2a3b4c5e

