table 'CG: Order Items Metrics'
	lineageTag: e1fa6f2d-cf31-4171-8307-46990e4d5130

	calculationGroup
		precedence: 22

		calculationItem Orders =
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
				VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
				
				RETURN
				SWITCH(
				    TRUE(),
				    NOT __IsTrendVisual, SELECTEDMEASURE(),
				    __IsDummyMeasure, [Total Order Items],
				    SELECTEDMEASURE()
				)

			formatStringDefinition =
					VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
					VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
					
					RETURN
					SWITCH(
						TRUE(),
						NOT __IsTrendVisual || NOT __IsDummyMeasure, SELECTEDMEASUREFORMATSTRING(),
						"#,##0"
					)

		calculationItem Revenue =
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
				VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
				
				RETURN
				SWITCH(
				    TRUE(),
				    NOT __IsTrendVisual, SELECTEDMEASURE(),
				    __IsDummyMeasure, [Total Revenue Order Items],
				    SELECTEDMEASURE()
				)

			formatStringDefinition =
					VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
					VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
					
					RETURN
					SWITCH(
						TRUE(),
						NOT __IsTrendVisual || NOT __IsDummyMeasure, SELECTEDMEASUREFORMATSTRING(),
						"$#,##0"
					)

		calculationItem AOV =
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
				VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
				
				RETURN
				SWITCH(
				    TRUE(),
				    NOT __IsTrendVisual, SELECTEDMEASURE(),
				    __IsDummyMeasure, [AOV Order Items],
				    SELECTEDMEASURE()
				)

			formatStringDefinition =
					VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
					VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
					RETURN
					SWITCH(
						TRUE(),
						NOT __IsTrendVisual || NOT __IsDummyMeasure, SELECTEDMEASUREFORMATSTRING(),
						"$#,##0.0"
					)

	column Metric
		dataType: string
		lineageTag: 84ccd351-2e1b-4921-bd30-ad5156fdc7bd
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

