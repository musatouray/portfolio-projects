table 'TBL Moving Averages'
	lineageTag: 92bcc0d3-6a84-4d2b-987f-3c379ce29079

	measure 'Selected Moving Average' =
			
			SELECTEDVALUE('TBL Moving Averages'[Dsiplay Name])
		lineageTag: af75adff-57da-43a8-a869-dd2f8c16ad64

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Month ID'
		formatString: 0
		lineageTag: ab8d67b3-0b06-40a0-b9dd-13750c3fd224
		summarizeBy: count
		isNameInferred
		sourceColumn: [Month ID]

		annotation SummarizationSetBy = Automatic

	column 'Dsiplay Name'
		lineageTag: ce05bd49-1d92-460b-a422-98d2cf581f95
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dsiplay Name]
		sortByColumn: 'Month ID'

		annotation SummarizationSetBy = Automatic

	partition 'TBL Moving Averages' = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Month ID", INTEGER,
				    "Dsiplay Name", STRING,
				    {
				        {3, "3M"},
				        {6, "6M"},
				        {9, "9M"},
				        {12, "12M"}
				    }
				)

	annotation PBI_Id = ee73cf041bde4253804d0b9000d673f3

