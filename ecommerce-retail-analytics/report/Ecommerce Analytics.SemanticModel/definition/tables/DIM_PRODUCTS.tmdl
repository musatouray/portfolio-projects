					),
					ECOMMERCE_RETAIL_DB_PROD_Database = Source{[Name = "ECOMMERCE_RETAIL_DB_PROD", Kind = "Database"]}[Data],
					MARTS_Schema = ECOMMERCE_RETAIL_DB_PROD_Database{[Name = "MARTS", Kind = "Schema"]}[Data],
					DIM_PRODUCTS_Table = MARTS_Schema{[Name = "DIM_PRODUCTS", Kind = "Table"]}[Data],
