				    {"Best Selling", "Others"},
				    SELECTCOLUMNS(DIM_PRODUCTS, "Product Name", DIM_PRODUCTS[PRODUCT_CATEGORY])
				)

	annotation PBI_Id = ec34c7837f1e477fbe46fa2ab99c38fa

