table 'CG Order Items Metrics'
	lineageTag: e1fa6f2d-cf31-4171-8307-46990e4d5130

	calculationGroup
		precedence: 22

		calculationItem Orders = ```
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
				VAR __IsMoMGrowth = ISSELECTEDMEASURE([Time Series MoM Growth %])
				VAR __IsPriorYearMeasure = ISSELECTEDMEASURE([Time Series PY])
				
				RETURN 
				SWITCH(
				    TRUE(),
				    NOT __IsTrendVisual, SELECTEDMEASURE(),
				    __IsMoMGrowth, [Time Series MoM Growth %],
				    __IsPriorYearMeasure, [Time Series PY],
				    [Total Order Items]
				)
				```

			formatStringDefinition = ```
					VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
					VAR __IsMoMGrowth = ISSELECTEDMEASURE([Time Series MoM Growth %])
					RETURN 
					SWITCH(
					    TRUE(),
					    NOT __IsTrendVisual, SELECTEDMEASUREFORMATSTRING(),
					   __IsTrendVisual && __IsMoMGrowth, SELECTEDMEASUREFORMATSTRING(),
					    "#,##0"
					)
					```

		calculationItem Revenue = ```
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
				VAR __IsMoMGrowth = ISSELECTEDMEASURE([Time Series MoM Growth %])
				VAR __IsPriorYearMeasure = ISSELECTEDMEASURE([Time Series PY])
				
				RETURN 
				SWITCH(
				    TRUE(),
				    NOT __IsTrendVisual, SELECTEDMEASURE(),
				   __IsMoMGrowth, [Time Series MoM Growth %],
				   __IsPriorYearMeasure, [Time Series PY],
				    [Total Revenue Order Items]
				)
				
				```

			formatStringDefinition = ```
					VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
					VAR __IsMoMGrowth = ISSELECTEDMEASURE([Time Series MoM Growth %])
					RETURN 
					SWITCH(
					    TRUE(),
					    NOT __IsTrendVisual, SELECTEDMEASUREFORMATSTRING(),
					   __IsTrendVisual && __IsMoMGrowth, SELECTEDMEASUREFORMATSTRING(),
					    "$#,##0"
					)
					```

		calculationItem AOV = ```
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME]) 
				VAR __IsMoMGrowth = ISSELECTEDMEASURE([Time Series MoM Growth %])
				VAR __IsPriorYearMeasure = ISSELECTEDMEASURE([Time Series PY])
				
				RETURN 
				SWITCH(
				    TRUE(),
				    NOT __IsTrendVisual, SELECTEDMEASURE(),
				    __IsMoMGrowth, [Time Series MoM Growth %],
				    __IsPriorYearMeasure, [Time Series PY],
				    [AOV Order Items]
				)
				
				```

			formatStringDefinition = ```
					VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
					VAR __IsMoMGrowth = ISSELECTEDMEASURE([Time Series MoM Growth %])
					RETURN 
					SWITCH(
					    TRUE(),
					    NOT __IsTrendVisual, SELECTEDMEASUREFORMATSTRING(),
					   __IsTrendVisual && __IsMoMGrowth, SELECTEDMEASUREFORMATSTRING(),
					    "$#,##0.0"
					)
					```

