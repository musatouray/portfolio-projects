table 'CG Selected Metric'
	lineageTag: 33520064-eee4-49cd-a076-ada596c46d59

	calculationGroup
		precedence: 20

		calculationItem Orders =
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR])
				VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
				
				RETURN
				SWITCH(
					TRUE(),
					NOT __IsTrendVisual, SELECTEDMEASURE(),
				    __IsDummyMeasure, [Total Orders],
				    SELECTEDMEASURE()
				)

			formatStringDefinition =
					VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR])
					VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
					
					RETURN
					SWITCH(
						TRUE(),
						NOT __IsTrendVisual || NOT __IsDummyMeasure, SELECTEDMEASUREFORMATSTRING(),
						"#,##0"
					)

		calculationItem Revenue =
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR])
				VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
				
				RETURN
				SWITCH(
					TRUE(),
					NOT __IsTrendVisual, SELECTEDMEASURE(),
				    __IsDummyMeasure, [Total Revenue],
				    SELECTEDMEASURE()
				)

			formatStringDefinition =
					VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR])
					VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
					
					RETURN
					SWITCH(
						TRUE(),
						NOT __IsTrendVisual || NOT __IsDummyMeasure, SELECTEDMEASUREFORMATSTRING(),
						"$#,##0"
					)

		calculationItem AOV =
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR])
				VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
				
				RETURN
				SWITCH(
					TRUE(),
					NOT __IsTrendVisual, SELECTEDMEASURE(),
				    __IsDummyMeasure, [Average Order Value],
				    SELECTEDMEASURE()
				)

			formatStringDefinition =
					VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR])
					VAR __IsDummyMeasure = ISSELECTEDMEASURE([Blank])
					RETURN
					SWITCH(
						TRUE(),
						NOT __IsTrendVisual || NOT __IsDummyMeasure, SELECTEDMEASUREFORMATSTRING(),
						"$#,##0.0"
					)

	column Metric
		dataType: string
		lineageTag: 2dc92d0a-897b-4f2b-9084-987901fd789e
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		formatString: 0
		lineageTag: 18dee944-7863-44a0-ab09-b19c77a09412
		summarizeBy: none
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

