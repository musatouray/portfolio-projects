table 'CG Rolling Averages'
	lineageTag: b6b515c4-930c-46f8-8ea0-5d7d7cc4a1c1

	calculationGroup
		precedence: 23

		calculationItem Actual = ```
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME]) 
				VAR __LastDateWithSales = CALCULATE( MAX(FCT_ORDER_ITEMS[ORDER_DATE]), ALLSELECTED(DIM_DATES) ) 
				VAR __FirstVisibleDate = MIN(DIM_DATES[DATE]) 
				
				RETURN 
				SWITCH( 
				    TRUE(), 
				    NOT __IsTrendVisual, SELECTEDMEASURE(),
				    __FirstVisibleDate <= __LastDateWithSales, SELECTEDMEASURE() 
				)
				
				```

		calculationItem 3M = ```
				
				VAR __IsTrendVisual = ISINSCOPE(DIM_DATES[DATE]) || ISINSCOPE(DIM_DATES[MONTH_YEAR]) || ISINSCOPE(DIM_DATES[MONTH_NAME])
				VAR __NumOfMonths = 3
				VAR __MaxSelectedDate = MAX( DIM_DATES[DATE] ) 
				VAR __Period = DATESINPERIOD( DIM_DATES[DATE], __MaxSelectedDate, -__NumOfMonths, MONTH )
				VAR __Result = 
				        CALCULATE( 
				            AVERAGEX(   
				                VALUES( DIM_DATES[MONTH_YEAR] ),   
				                SELECTEDMEASURE() 
				            ), 
				            __Period 
				        ) 
				
				VAR __LastDateWithSales = MAX(FCT_ORDER_ITEMS[ORDER_DATE])
				VAR __FirstVisibleDate = MIN(DIM_DATES[DATE]) 
				
				RETURN 
				SWITCH(
				    TRUE(),
				    NOT __IsTrendVisual, SELECTEDMEASURE(),
				    __FirstVisibleDate <= __LastDateWithSales, __Result
				)
				
				```

