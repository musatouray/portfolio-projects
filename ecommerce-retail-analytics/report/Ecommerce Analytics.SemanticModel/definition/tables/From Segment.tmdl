/// Disconnected segment dimension for the "from" (prior snapshot) axis of the
/// RFM segment-migration visuals. Not related to any table; used only by the
/// transition measures via SELECTEDVALUE.
table 'From Segment'
	lineageTag: f2a10001-0001-4001-8001-000000000001

	column 'From Segment'
		lineageTag: f2a10001-0001-4001-8001-000000000002
		summarizeBy: none
		isNameInferred
		sourceColumn: [From Segment]
		sortByColumn: 'From Index'

		annotation SummarizationSetBy = Automatic

	column 'From Index'
		isHidden
		lineageTag: f2a10001-0001-4001-8001-000000000003
		summarizeBy: none
		isNameInferred
		sourceColumn: [From Index]

		annotation SummarizationSetBy = Automatic

	partition 'From Segment' = calculated
		mode: import
		source =
				DISTINCT (
				    SELECTCOLUMNS (
				        FCT_RFM_SEGMENTS,
				        "From Segment", FCT_RFM_SEGMENTS[RFM_SEGMENT],
				        "From Index", FCT_RFM_SEGMENTS[SEGMENT_INDEX]
				    )
				)

	annotation PBI_Id = a1f0c2d34e5f4a6b8c9d0e1f2a3b4c5d

