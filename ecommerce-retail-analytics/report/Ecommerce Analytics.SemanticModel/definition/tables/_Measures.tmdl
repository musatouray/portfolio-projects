	measure 'Display Rank Number' = ```
			
			VAR __SelectedTopBottomN = SELECTEDVALUE('Top/Bottom Selector'[Top/Bottom N])
			VAR __CurrentRevenue = [Order Items Total Revenue]
			
			-- 1. Create a global active table ignoring the local visual row context
			VAR __GlobalActiveCategories = 
			    CALCULATETABLE(
			        FILTER(
			            ALL(DIM_PRODUCTS[PRODUCT_CATEGORY]), 
			            [Order Items Total Revenue] > 0
			        ),
			        ALLSELECTED() -- Respects date slicers/page filters, ignores the table row filter
			    )
			VAR __TotalCount = COUNTROWS(__GlobalActiveCategories)
			
			-- 2. Compute the exact ranking position in the global context
			VAR __GlobalTopRank = 
			    IF(
			        __CurrentRevenue > 0,
			        RANKX(
			            __GlobalActiveCategories, 
			            [Order Items Total Revenue], 
			            __CurrentRevenue, 
			            DESC, 
			            Dense
			        )
			    )
			    
			VAR __GlobalBottomRank = (__TotalCount - __GlobalTopRank + 1)
			VAR __MiddleRankValue = INT(__TotalCount / 2) + 1
			
			RETURN
			    IF(
			        ISINSCOPE(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			        SWITCH(
			            TRUE(),
			            -- Top N rows 
			            __GlobalTopRank <= __SelectedTopBottomN, 
			            __GlobalTopRank,
			            
			            -- Bottom N rows 
			            __GlobalBottomRank <= __SelectedTopBottomN, 
			            __GlobalTopRank, 
			            
			            -- Middle row stays blank
			            __GlobalTopRank = __MiddleRankValue, 
			            "⋮",
			
			            "⋮"
			        )
			    )
			
			```
		displayFolder: 12_Top/Bottom N
		lineageTag: b73d1c37-36be-4357-8ef4-97b96a2228a5

		formatStringDefinition = ```
				VAR __RankNumber = [Display Rank Number]
				RETURN
				IF(
				    ISBLANK(__RankNumber),  
				    "⋮", 
				    "#,#0"
				)
				```

	measure 'Display Revenue Value' = ```
			
			VAR __Revenue = [Order Items Total Revenue]
			VAR __ActiveCategories = FILTER(ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]), [Order Items Total Revenue] > 0)
			VAR __TotalCount = COUNTROWS(__ActiveCategories)
			VAR __TopRank = RANKX(__ActiveCategories, [Order Items Total Revenue], __Revenue, DESC, Dense)
			
			-- Define the two middle rows
			VAR __MiddleRankValue1 = INT(__TotalCount / 2)
			VAR __MiddleRankValue2 = __MiddleRankValue1 + 1
			
			RETURN
			    IF(
			        __TopRank = __MiddleRankValue1 || __TopRank = __MiddleRankValue2, 
			        "⋮", 
			        __Revenue
			    )
			
			
			```
		displayFolder: 12_Top/Bottom N
		lineageTag: 7da7cb70-e57f-47e6-aeb5-c1c61fa60e20

		formatStringDefinition = ```
				VAR __FormattedRevenue = [Display Revenue Value]
				RETURN
				    SWITCH (
				        TRUE (),
				        ISBLANK(__FormattedRevenue), "⋮",
				        __FormattedRevenue <= 1E3, "$#,0.;-#,0.;0",
				        __FormattedRevenue <= 1E4, "$#,0,.00K;-#,0,.00K;0",
				        __FormattedRevenue <= 1E5, "$#,0,.0K;-#,0,.0K;0",
				        __FormattedRevenue <= 1E6, "$#,0,.K;-#,0,.K;0",
				        __FormattedRevenue <= 1E7, "$#,0,,.00M;-#,0,,.00M;0",
				        __FormattedRevenue <= 1E8, "$#,0,,.0M;-#,0,,.0M;0",
				        __FormattedRevenue <= 1E9, "$#,0,,.M;-#,0,,.M;0"
				    )
				
				```

	measure 'Ranking Sort Order' = ```
			
			VAR __SelectedTopBottomN = SELECTEDVALUE('Top/Bottom Selector'[Top/Bottom N])
			VAR __CurrentRevenue = [Order Items Total Revenue]
			
			VAR __GlobalActiveCategories = 
			    CALCULATETABLE(
			        FILTER(
			            ALL(DIM_PRODUCTS[PRODUCT_CATEGORY]), 
			            [Order Items Total Revenue] > 0
			        ),
			        ALLSELECTED()
			    )
			VAR __TotalCount = COUNTROWS(__GlobalActiveCategories)
			
			VAR __GlobalTopRank = 
			    IF(
			        __CurrentRevenue > 0,
			        RANKX(__GlobalActiveCategories, [Order Items Total Revenue], __CurrentRevenue, DESC, Dense)
			    )
			VAR __GlobalBottomRank = (__TotalCount - __GlobalTopRank + 1)
			
			-- Define the two middle rows
			VAR __MiddleRankValue1 = INT(__TotalCount / 2)
			VAR __MiddleRankValue2 = __MiddleRankValue1 + 1
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- Top N rows
			        __GlobalTopRank <= __SelectedTopBottomN, __GlobalTopRank,
			        
			        -- First separator row slotted right after Top N
			        __GlobalTopRank = __MiddleRankValue1, __SelectedTopBottomN + 1,
			        
			        -- Second separator row slotted right after the first separator
			        __GlobalTopRank = __MiddleRankValue2, __SelectedTopBottomN + 2,
			        
			        -- Bottom N rows follow right after the second separator row
			        __GlobalBottomRank <= __SelectedTopBottomN, __SelectedTopBottomN + 2 + (__SelectedTopBottomN - __GlobalBottomRank + 1),
			        
			        BLANK()
			    )
			
			```
		formatString: 0
		displayFolder: 12_Top/Bottom N
		lineageTag: 69600995-ccb3-4ba8-b7e4-418cddc4b119

	measure 'Display Orders Total' = ```
			
			VAR __TotalOrders = [Order Items Total Orders]
			VAR __ActiveCategories = FILTER(ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]), [Order Items Total Orders] > 0)
			VAR __TotalCount = COUNTROWS(__ActiveCategories)
			VAR __TopRank = RANKX(__ActiveCategories, [Order Items Total Orders], __TotalOrders, DESC, Dense)
			
			-- Define the two middle rows
			VAR __MiddleRankValue1 = INT(__TotalCount / 2)
			VAR __MiddleRankValue2 = __MiddleRankValue1 + 1
			
			RETURN
			    IF(
			        __TopRank = __MiddleRankValue1 || __TopRank = __MiddleRankValue2, 
			       "⋮", 
			        __TotalOrders
			    )
			
			```
		displayFolder: 12_Top/Bottom N
		lineageTag: f624ace9-587b-45d9-9381-1030ae05392f

		formatStringDefinition =
				VAR __Orders = [Display Orders Total]
				RETURN
				IF(
				    ISBLANK(__Orders),
				    "⋮",
				    "#,0"
				)

	measure 'Display % of Grand Total' = ```
			
			VAR __Revenue = [Order Items Total Revenue]
			
			-- 1. Calculate the true global grand total revenue across all active categories, ignoring the visual filter
			VAR __GlobalGrandTotalRevenue = 
			    CALCULATE(
			        [Order Items Total Revenue],
			        REMOVEFILTERS(DIM_PRODUCTS[PRODUCT_CATEGORY])
			    )
			
			-- 2. Figure out the ranks to identify the middle separator rows
			VAR __ActiveCategories = FILTER(ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]), [Order Items Total Revenue] > 0)
			VAR __TotalCount = COUNTROWS(__ActiveCategories)
			VAR __TopRank = RANKX(__ActiveCategories, [Order Items Total Revenue], __Revenue, DESC, Dense)
			
			VAR __MiddleRankValue1 = INT(__TotalCount / 2)
			VAR __MiddleRankValue2 = __MiddleRankValue1 + 1
			
			RETURN
			    IF(
			        __TopRank = __MiddleRankValue1 || __TopRank = __MiddleRankValue2, 
			        "⋮", 
			        DIVIDE(__Revenue, __GlobalGrandTotalRevenue)
			    )
			
			```
		displayFolder: 12_Top/Bottom N
		lineageTag: 2ac812b3-3eab-4ee0-b340-0953e3b83dbe

		formatStringDefinition = ```
				VAR __PercentValue = [Display % of Grand Total]
				RETURN 
				    IF(
				        ISBLANK(__PercentValue), 
				        "⋮",
				        "0.00%"
				    )
				```

