	measure 'Churn Status %' =
			DIVIDE(
				COUNTROWS(FCT_CHURN_RISK),
				CALCULATE(COUNTROWS(FCT_CHURN_RISK), ALLSELECTED(FCT_CHURN_RISK[CHURN_STATUS]))
			)
		formatString: 0.0%
