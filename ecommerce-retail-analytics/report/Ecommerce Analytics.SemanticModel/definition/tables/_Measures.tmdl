	/// Lifetime cohort revenue across all periods (ignores period filter)
	measure 'Cohort Lifetime Revenue' =
			CALCULATE(
				SUM(FCT_COHORT_RETENTION[PERIOD_REVENUE]),
				ALL(FCT_COHORT_RETENTION[PERIOD_NUMBER])
			)
		formatString: $#,0;-$#,0;$#,0
		displayFolder: 05_Cohort
		lineageTag: 8a9b0c1d-2e3f-4a5b-6c7d-8e9f0a1b2c3d

	/// Lifetime cohort orders across all periods (ignores period filter)
	measure 'Cohort Lifetime Orders' =
			CALCULATE(
				SUM(FCT_COHORT_RETENTION[PERIOD_ORDERS]),
				ALL(FCT_COHORT_RETENTION[PERIOD_NUMBER])
