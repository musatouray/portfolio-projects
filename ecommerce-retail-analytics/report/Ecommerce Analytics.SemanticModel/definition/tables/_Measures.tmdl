		displayFolder: 14_Viz Helpers
		lineageTag: a82de0d3-6890-4821-8eea-6dcf369a05c4

	measure 'Revenue Format Large' =
			VAR Rev = [Total Revenue]
			RETURN
				SWITCH(
					TRUE(),
					Rev >= 1000000, FORMAT(Rev / 1000000, "$#,##0.0") & "M",
					Rev >= 1000, FORMAT(Rev / 1000, "$#,##0.0") & "K",
					FORMAT(Rev, "$#,##0")
				)
		displayFolder: 14_Viz Helpers
		lineageTag: 4ef40a4b-bbb1-4cf5-bd24-8b4c1de1629e

	measure 'Prior Year Customers' = ```
			
			// Using UDF function to dynamically calculate SPLY
			TimeIntelligence.PY([Unique Customers])
			
			```
		displayFolder: 08_Time Intelligence\_PY
		lineageTag: 404ab817-ecde-4fbb-b7ef-80b00977e4f9

		formatStringDefinition =
				VAR __FormattedUniqueCustomers = [Prior Year Customers]
				RETURN
				    SWITCH (
				        TRUE (),
				        __FormattedUniqueCustomers <= 1E3, "#,0;-#,0;0",
				        __FormattedUniqueCustomers <= 1E4, "#,0,K;-#,0,K;0",
				        __FormattedUniqueCustomers <= 1E5, "#,0,K;-#,0,K;0",
				        __FormattedUniqueCustomers <= 1E6, "#,0,K;-#,0,K;0",
				        __FormattedUniqueCustomers <= 1E7, "#,0,,M;-#,0,,M;0",
				        __FormattedUniqueCustomers <= 1E8, "#,0,,M;-#,0,,M;0",
				        __FormattedUniqueCustomers <= 1E9, "#,0,,M;-#,0,,M;0"
				    )

	measure 'Unique Customers YoY %' = ```
			
			VAR CurrentPeriod = [Unique Customers]
			VAR PriorYear = [Prior Year Customers]
			
			RETURN 
			DIVIDE(CurrentPeriod - PriorYear, PriorYear)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08_Time Intelligence\_YoY
		lineageTag: 51dc3bae-2fd1-4920-9da5-e0d98256c624

	/// Running total of revenue. ALLSELECTED preserves the user's date slicer
	/// (previous ALL(DIM_DATES) ignored slicer scope, producing wrong values when filtered).
	measure 'Cumulative Revenue' =
			CALCULATE(
				[Total Revenue],
				FILTER(
					ALLSELECTED(DIM_DATES[DATE]),
					DIM_DATES[DATE] <= MAX(DIM_DATES[DATE])
				)
			)
		formatString: $#,##0
		displayFolder: 08_Time Intelligence
		lineageTag: 87359a09-a8f0-4bff-915d-b8459844a18d

	measure 'Cumulative Orders' =
			CALCULATE(
				[Total Orders],
				FILTER(
					ALLSELECTED(DIM_DATES[DATE]),
					DIM_DATES[DATE] <= MAX(DIM_DATES[DATE])
				)
			)
		formatString: #,##0
		displayFolder: 08_Time Intelligence
		lineageTag: 2bcc1bb1-d1f0-4cac-a2ac-0c0d1ff83e45

	/// =============================================
	/// _Analytical Measures
	/// =============================================
	/// Customers with exactly 1 order. Uses ADDCOLUMNS + SUMMARIZE keys-only
	/// (modern pattern preferred over SUMMARIZE-with-extension-columns).
	/// Long-term: push IS_SINGLE_PURCHASER flag from dbt (already exists in
	/// FCT_CHURN_RISK) and replace this with CALCULATE(..., flag = TRUE).
	measure 'Single Purchaser Count' =
			VAR _CustomerOrders =
				ADDCOLUMNS(
					SUMMARIZE(FCT_ORDERS, DIM_CUSTOMERS[CUSTOMER_UNIQUE_ID]),
					"@Orders", CALCULATE(COUNTROWS(FCT_ORDERS))
				)
			RETURN
				COUNTROWS(FILTER(_CustomerOrders, [@Orders] = 1))
		formatString: #,##0
		displayFolder: 07_Analytical
		lineageTag: b8bd4d15-a789-4f25-a696-2056dae8a8e2

	measure 'Repeat Purchaser Count' =
			VAR _CustomerOrders =
				ADDCOLUMNS(
					SUMMARIZE(FCT_ORDERS, DIM_CUSTOMERS[CUSTOMER_UNIQUE_ID]),
					"@Orders", CALCULATE(COUNTROWS(FCT_ORDERS))
				)
			RETURN
				COUNTROWS(FILTER(_CustomerOrders, [@Orders] > 1))
		formatString: #,##0
		displayFolder: 07_Analytical
		lineageTag: 9da1b9a1-af61-496a-93f7-5693387636ff

	measure 'Single Purchaser %' = DIVIDE([Single Purchaser Count], [Unique Customers], 0)
		formatString: 0.0%
		displayFolder: 07_Analytical
		lineageTag: a1000003-0001-0001-0001-000000000003

	measure 'Repeat Purchaser %' = DIVIDE([Repeat Purchaser Count], [Unique Customers], 0)
		formatString: 0.0%
		displayFolder: 07_Analytical
		lineageTag: a1000004-0001-0001-0001-000000000004

	measure 'Avg Orders per Customer' = DIVIDE([Total Orders], [Unique Customers], 0)
