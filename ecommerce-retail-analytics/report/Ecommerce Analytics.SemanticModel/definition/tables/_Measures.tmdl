		displayFolder: 15_Landing Page
		lineageTag: f2d7dde3-02e7-48f8-9bcd-a1b401761b0a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RFM Segment Colors' = ```
			
			VAR __Segments = SELECTEDVALUE(FCT_RFM_SEGMENTS[RFM_SEGMENT])
			RETURN
			SWITCH(
			    __Segments,
			    "Champions", "#1E3A5F",
			    "Loyal", "#4B617F",
			    "Potential Loyalists", "#78899F",
			    "Cant Lose Them", "#A5B0BF",
			    "Need Attention", "#4A6FA5",
