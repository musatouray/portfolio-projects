	measure 'Rank: Products by Revenue' = ```
			
			VAR __SelectedTopBottomN = SELECTEDVALUE('Top/Bottom Selector'[Top/Bottom N])
			VAR __Revenue = [Order Items Total Revenue]
			
			-- Create a virtual table of all categories where revenue is greatert han 0
			VAR __ActiveCategories = 
			    FILTER(
			        ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			        [Order Items Total Revenue] > 0
			    )
			VAR __TotalCount = COUNTROWS(__ActiveCategories)
			
			-- Top ranking
			VAR __TopRank = 
			    IF(
			        __Revenue > 0 && ISINSCOPE(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			        RANKX(__ActiveCategories, [Order Items Total Revenue], __Revenue, DESC, Dense)
			    )
			
			-- Bottom ranking 
			VAR __BottomRank = 
			    IF(
			        __Revenue > 0 && ISINSCOPE(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			        RANKX(__ActiveCategories, [Order Items Total Revenue], __Revenue, ASC, Dense)
			    )
			
			-- Define the two consecutive middle rows
			VAR __MiddleRankValue1 = INT(__TotalCount / 2)
			VAR __MiddleRankValue2 = __MiddleRankValue1 + 1
			
			VAR __IsMiddleRow = (__TopRank = __MiddleRankValue1 || __TopRank = __MiddleRankValue2)
			
			RETURN 
			    IF(
			        __Revenue > 0 && 
			        (__TopRank <= __SelectedTopBottomN || __BottomRank <= __SelectedTopBottomN || __IsMiddleRow), 
			        1, 
			        0
			    )
			
			```
		formatString: 0
		displayFolder: 12_Top/Bottom N
		lineageTag: 04bdcdb9-221d-4a37-8b53-71ec20ebb821

	measure 'Display Category' = ```
			
			VAR __Revenue = [Order Items Total Revenue]
			VAR __ActiveCategories = FILTER(ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]), [Order Items Total Revenue] > 0)
			VAR __TotalCount = COUNTROWS(__ActiveCategories)
			VAR __TopRank = RANKX(__ActiveCategories, [Order Items Total Revenue], __Revenue, DESC, Dense)
			
			-- Define the two middle rows
			VAR __MiddleRankValue1 = INT(__TotalCount / 2)
			VAR __MiddleRankValue2 = __MiddleRankValue1 + 1
			
			RETURN
			    IF(
			        __TopRank = __MiddleRankValue1 || __TopRank = __MiddleRankValue2,
			        "⋮", 
			        SELECTEDVALUE(DIM_PRODUCTS[PRODUCT_CATEGORY])
			    )
			
