	/// Difference P1 - P6. Format string fixed (was '0', producing 0 for values < 1).
	measure 'Avg P1-P6 Drop' = [P1 Retention Rate] - [P6 Retention Rate]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05_Cohort
		lineageTag: 4bda322f-7e8b-4f1e-bfc6-523971f75037

	/// Size of the most recent cohort (P0). Stash MAX(COHORT_KEY) in a VAR so
	/// it evaluates once under the outer filter context, then filter the table.
	measure 'Latest Cohort Size' =
			
			VAR _LatestCohort = CALCULATE(MAX(FCT_COHORT_RETENTION[COHORT_KEY]), ALLSELECTED(FCT_COHORT_RETENTION))
			RETURN
				CALCULATE(
					SUM(FCT_COHORT_RETENTION[COHORT_SIZE]),
					KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_KEY] = _LatestCohort),
					KEEPFILTERS(FCT_COHORT_RETENTION[PERIOD_NUMBER] = 0)
				)
		formatString: #,##0
		displayFolder: 05_Cohort
		lineageTag: ab0820fd-6338-40f8-92d7-372b90ed9185

