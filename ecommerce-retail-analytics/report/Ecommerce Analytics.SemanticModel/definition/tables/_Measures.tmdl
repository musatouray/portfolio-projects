				        __FormattedOrders <= 1E5, "#,0,K;-#,0,K;0",
				        __FormattedOrders <= 1E6, "#,0,K;-#,0,K;0",
				        __FormattedOrders <= 1E7, "#,0,,M;-#,0,,M;0",
				        __FormattedOrders <= 1E8, "#,0,,M;-#,0,,M;0",
				        __FormattedOrders <= 1E9, "#,0,,M;-#,0,,M;0"
				    )

	measure 'Orders YoY %' = ```
			
			VAR CurrentPeriod = [Total Orders]
			VAR PriorYear = [Prior Year Orders]
			
			RETURN 
			DIVIDE(CurrentPeriod - PriorYear, PriorYear, 0)
