	measure 'Pareto Cutoff Marker' = ```
			
			VAR __Threshold = [Param: Pareto Threshold Value]
			
			-- 1. Grab the baseline running total table layout
			VAR __CategoryTable = 
			    ADDCOLUMNS( 
			        ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]), 
			        "@CategoryPct", [Product Revenue % of Grand Total] 
			    )
			
			-- 2. Fetch the running total for the CURRENT category on the axis step
			VAR __CurrentRunningTotal = [Running Total Product Revenue %]
			
			-- 3. Calculate the running total up to the PREVIOUS category
			VAR __PreviousRunningTotal = 
			    SUMX(
			        WINDOW(
			            1, ABS,
			            -1, REL,
			            __CategoryTable,
			            ORDERBY([@CategoryPct], DESC)
			        ),
			        [@CategoryPct]
			    )
			
			-- 4. Identify if this specific category is the one that crosses the threshold line
			VAR __IsIntersectionCategory = 
			    __CurrentRunningTotal >= __Threshold && 
			    (__PreviousRunningTotal < __Threshold || ISBLANK(__PreviousRunningTotal))
			
			RETURN
			    IF(
			        __IsIntersectionCategory && NOT ISBLANK([Order Items Total Revenue]),
			        __CurrentRunningTotal
			    )
			
			```
		formatString: 0%;-0%;0%
		displayFolder: 03_Product
		lineageTag: c30950be-ae72-467d-8f2a-0ff8c3428c98

	measure 'Pareto Category Color Flag' = ```
			
			VAR __Threshold = [Param: Pareto Threshold Value]
			
			-- 1. Grab the baseline running total table layout using your percentage measure
			VAR __CategoryTable = 
			    ADDCOLUMNS( 
			        ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]), 
			        "@CategoryPct", [Product Revenue % of Grand Total] 
			    )
			
			-- 2. Fetch the running total for the CURRENT category on the axis step
			VAR __CurrentRunningTotal = [Running Total Product Revenue %]
			
			-- 3. Directly calculate the previous running total by summing the percentages up to 1 row ago
			VAR __PreviousRunningTotal = 
			    SUMX(
			        WINDOW(
			            1, ABS,
			            -1, REL,
			            __CategoryTable,
			            ORDERBY([@CategoryPct], DESC)
			        ),
			        [@CategoryPct]
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK([Order Items Total Revenue]), BLANK(),
			        
			        -- Keeps categories under the limit, plus the single category that breaches the threshold line
			        __CurrentRunningTotal <= __Threshold || __PreviousRunningTotal < __Threshold, "Within Threshold",
			        "Outside Threshold"
			    )
			
			```
		formatString: @
		displayFolder: 03_Product
		lineageTag: 7cda3bb6-03ec-42b2-824e-abdac550e69c

		annotation PBI_FormatHint = {"isText":true}

	measure 'RFM Latest Snapshot' = SELECTEDVALUE('Disconnected Calendar'[MONTH_START_DATE])
		displayFolder: 01_Segments\RFM
		lineageTag: 81640380-77e9-4b8a-a8b4-f884b9f0d7df

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RFM PY Snapshot' = ```
			
			VAR PriorYearSnapshot = [RFM Latest Snapshot]                                                                                      
			RETURN                                                                                                                             
			IF(                                                                                                                                
			    NOT(ISBLANK(PriorYearSnapshot)),                                                                                                                        
			    EDATE(PriorYearSnapshot, -12)                                                                                                    
			) 
			```
		displayFolder: 01_Segments\RFM
		lineageTag: 33afbc92-c33b-4eea-94a9-c68ff175549e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RFM Period Revenue' = ```
			
			VAR __SelectedMonth = [RFM Latest Snapshot]                                   
			VAR __MonthEnd = EOMONTH(__SelectedMonth, 0)                                                                                       
			VAR __CustomersInSegment =                                                                                                         
			    CALCULATETABLE(                                                                                                                
			        VALUES(FCT_RFM_SEGMENTS[CUSTOMER_KEY]),                                                                                    
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __SelectedMonth                                                                         
			    )                                                                                                                              
			RETURN                                                                                                                             
			IF(                                                                                                                                
			    NOT ISBLANK(__SelectedMonth),                                                                                                  
			    CALCULATE(                                                                                                                     
			        SUM(FCT_ORDERS[TOTAL_PAYMENT_VALUE]),                                                                                      
			        FCT_ORDERS[ORDER_DATE] >= __SelectedMonth,                                                                                 
			        FCT_ORDERS[ORDER_DATE] <= __MonthEnd,                                                                                      
			        TREATAS(__CustomersInSegment, FCT_ORDERS[CUSTOMER_KEY])                                                                    
			    )                                                                                                                              
			)                     
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 01_Segments\RFM
		lineageTag: d72446b8-8ed8-468b-849a-d0e67339498a

	/// =============================================
	/// _RFM Segment Migration (Transition) Measures
	/// Powers the migration heatmap (matrix) and the Deneb Sankey.
	/// 'From Segment' / 'To Segment' are disconnected dimensions; each cell/link
	/// counts customers who were in From Segment at the prior snapshot and in
	/// To Segment at the latest (or slicer-selected) snapshot. Cumulative snapshots
	/// guarantee every prior-month customer also exists in the current month.
	/// =============================================
	measure 'Transition Count' = ```
			
			VAR ToMonth =
			    MAXX ( ALLSELECTED ( FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] ), FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] )
			VAR FromMonth = EDATE ( ToMonth, -1 )
			VAR FromSeg = SELECTEDVALUE ( 'From Segment'[From Segment] )
			VAR ToSeg = SELECTEDVALUE ( 'To Segment'[To Segment] )
			VAR FromCustomers =
			    CALCULATETABLE (
			        VALUES ( FCT_RFM_SEGMENTS[CUSTOMER_KEY] ),
			        REMOVEFILTERS ( FCT_RFM_SEGMENTS ),
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = FromMonth,
			        FCT_RFM_SEGMENTS[RFM_SEGMENT] = FromSeg
			    )
			VAR ToCustomers =
			    CALCULATETABLE (
			        VALUES ( FCT_RFM_SEGMENTS[CUSTOMER_KEY] ),
			        REMOVEFILTERS ( FCT_RFM_SEGMENTS ),
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = ToMonth,
			        FCT_RFM_SEGMENTS[RFM_SEGMENT] = ToSeg
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( FromSeg ) && NOT ISBLANK ( ToSeg ),
			        COUNTROWS ( INTERSECT ( FromCustomers, ToCustomers ) )
			    )
			
			```
		formatString: #,##0
		displayFolder: 01_Segments\RFM\Transitions
		lineageTag: rt100001-0001-0001-0001-000000000001

	/// Share of the source segment (prior snapshot) that moved to this target segment.
	measure 'Transition % of Source' = ```
			
			VAR ToMonth =
			    MAXX ( ALLSELECTED ( FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] ), FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] )
			VAR FromMonth = EDATE ( ToMonth, -1 )
			VAR FromSeg = SELECTEDVALUE ( 'From Segment'[From Segment] )
			VAR SourceSize =
			    CALCULATE (
			        DISTINCTCOUNT ( FCT_RFM_SEGMENTS[CUSTOMER_KEY] ),
			        REMOVEFILTERS ( FCT_RFM_SEGMENTS ),
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = FromMonth,
			        FCT_RFM_SEGMENTS[RFM_SEGMENT] = FromSeg
			    )
			RETURN
			    DIVIDE ( [Transition Count], SourceSize )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01_Segments\RFM\Transitions
		lineageTag: rt100002-0001-0001-0001-000000000002

	/// Dynamic subtitle for the migration visuals, e.g. "Segment migration: May 2026 -> Jun 2026".
	measure 'Transition Window Label' = ```
			
			VAR ToMonth =
			    MAXX ( ALLSELECTED ( FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] ), FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] )
			VAR FromMonth = EDATE ( ToMonth, -1 )
			RETURN
			    "Segment migration:  " & FORMAT ( FromMonth, "MMM yyyy" ) & "   " & UNICHAR ( 8594 ) & "   " & FORMAT ( ToMonth, "MMM yyyy" )
			
			```
		displayFolder: 01_Segments\RFM\Transitions
		lineageTag: rt100003-0001-0001-0001-000000000003

	measure 'Low Value CLV Revenue %' = ```
			
			VAR __HistoricalCLV = [Total Historical CLV]
			VAR __LowValue = 
			    CALCULATE(
			        SUM(FCT_CLV_CUSTOMER[TOTAL_LIFETIME_REVENUE]), 
			        FCT_CLV_CUSTOMER[CUSTOMER_VALUE_SEGMENT] = "low_value"
			    )
			
			RETURN
			DIVIDE(
				__LowValue,
			    __HistoricalCLV
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01_Segments\CLV
		lineageTag: 5397585f-eb39-40ec-8578-bf754b59ba13

