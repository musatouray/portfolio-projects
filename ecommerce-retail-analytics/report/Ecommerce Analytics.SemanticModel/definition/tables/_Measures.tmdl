	/// State's share of total revenue. ALLSELECTED preserves other slicers
	/// (e.g. a Year/Quarter selection) while still computing the cross-state total.
	measure 'Revenue % of Total' =
			DIVIDE(
				[Geo Revenue],
				CALCULATE([Geo Revenue], ALLSELECTED(FCT_GEO_PERFORMANCE[STATE]))
			)
		formatString: 0.0%
