	/// =============================================
	/// _Metadata - data freshness stamp
	/// =============================================
	/// Stamps the report with the timestamp of the most recent model refresh.
	/// Pin this next to the report title so viewers always know how fresh the data is.
	measure 'Last Refresh' = "Refreshed: " & FORMAT(NOW(), "yyyy-mm-dd hh:mm")
		displayFolder: 13_Metadata
		lineageTag: meta0001-0001-0001-0001-000000000001

	/// =============================================
	/// _Role-Playing Date Dimension (Delivery Date)
	/// Activates the inactive FCT_ORDERS[DELIVERY_DATE_KEY] relationship.
	/// =============================================
	measure 'Revenue by Delivery Date' =
			
			CALCULATE(
				[Total Revenue],
				USERELATIONSHIP(FCT_ORDERS[DELIVERY_DATE_KEY], DIM_DATES[DATE_KEY])
			)
		formatString: $#,##0
		displayFolder: 08_Time Intelligence\_Delivery
		lineageTag: rp100001-0001-0001-0001-000000000001

	measure 'Orders by Delivery Date' =
			
			CALCULATE(
				[Total Orders],
				USERELATIONSHIP(FCT_ORDERS[DELIVERY_DATE_KEY], DIM_DATES[DATE_KEY])
			)
		formatString: #,##0
		displayFolder: 08_Time Intelligence\_Delivery
		lineageTag: rp100002-0001-0001-0001-000000000002

	measure 'Max Selected Metric' = ```
			
			
			-- Step 1: Capture the exact value of the current coordinate on the X-Axis
			VAR __CurrentValue = [Blank]
			
			-- Step 2: Calculate the highest value across the entire visible X-Axis timeline
			VAR __MaxValueOnChart = 
			    MAXX(
			        ALLSELECTED(DIM_DATES[DATE]),
			        CALCULATE(
			            [Blank],
			            -- Force context transition to evaluate [Blank] for each specific date row
			            DIM_DATES[DATE] = EARLIER(DIM_DATES[DATE])
			        )
			    )
			
			RETURN
			    -- Step 3: Draw a data point ONLY if it matches the peak value
			    IF( __CurrentValue = __MaxValueOnChart, __MaxValueOnChart )
			
			
			
			// VAR __SelectedMetric = SELECTEDVALUE('CG Selected Metric'[Metric])
			
			// VAR __MaxYearly = 
			//     MAXX(
			//         ALLSELECTED(DIM_DATES[MONTH_YEAR]),
			//         __SelectedMetric
			//     )
			// RETURN
			//     IF(
			//         __MaxYearly = __SelectedMetric, __MaxYearly
			//     )
			
			```
		displayFolder: 14_Viz Helpers
		lineageTag: c83012e3-e111-47d6-87ed-db1e27c63aa5

