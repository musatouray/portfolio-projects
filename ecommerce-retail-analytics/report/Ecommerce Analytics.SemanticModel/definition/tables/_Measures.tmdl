	/// Lifetime cohort revenue across all periods (ignores period filter)
	measure 'Cohort Initial Revenue' = ```
			
			VAR __CohortSize = [Param: Cohort Size Value] 
			VAR __CohortAsOfDate = [As on Cohort Date] 
			RETURN 
			CALCULATE( 
			    SUM(FCT_COHORT_RETENTION[COHORT_INITIAL_REVENUE]),
				FCT_COHORT_RETENTION[PERIOD] = 0, 
			    KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_MONTH] <= __CohortAsOfDate),
			    KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_SIZE] >= __CohortSize)
			)
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
