	/// Blended P1 retention rate (weighted by cohort size). Avoids
	/// average-of-averages bias when slicing across multiple cohorts.
	measure 'P1 Retention Rate' =
			
			CALCULATE(
				[Retention Rate],
				FCT_COHORT_RETENTION[PERIOD] = 1
			)
		displayFolder: 05_Cohort
