	measure 'Churn Status Color' =
			VAR ChurnRate = [Churn Rate]
			RETURN
				SWITCH(
					TRUE(),
					ChurnRate > 0.5, "#D84315",
					ChurnRate > 0.3, "#FF7043",
					ChurnRate > 0.1, "#FFA000",
					"#2E7D32"
				)
		displayFolder: 14_Viz Helpers
		lineageTag: 1434d74d-f4b9-43e8-8488-1728c57b5353

	measure 'Retention Heatmap Color' =
			VAR RetRate = [Retention Rate]
			RETURN
				SWITCH(
					TRUE(),
					RetRate >= 0.8, "#1E3A5F",
					RetRate >= 0.6, "#1E88E5",
					RetRate >= 0.4, "#42A5F5",
					RetRate >= 0.2, "#90CAF9",
