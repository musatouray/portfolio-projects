	/// Recomputes MoM growth from the daily fact instead of SUM-ing pre-aggregated
	/// percentages (which produced nonsense when sliced over >1 day).
	measure 'TS Revenue MoM %' =
			VAR _Curr = [Daily Revenue]
			VAR _Prev = CALCULATE([Daily Revenue], DATEADD(DIM_DATES[DATE], -1, MONTH))
			RETURN DIVIDE(_Curr - _Prev, _Prev)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 09_Time Series
		lineageTag: ts100007-0001-0001-0001-000000000007

	/// Recomputes YoY growth from the daily fact instead of SUM-ing pre-aggregated
	/// percentages. Requires DIM_DATES to be marked as a Date Table for correct results.
	measure 'TS Revenue YoY %' =
			VAR _Curr = [Daily Revenue]
			VAR _Prev = CALCULATE([Daily Revenue], SAMEPERIODLASTYEAR(DIM_DATES[DATE]))
			RETURN DIVIDE(_Curr - _Prev, _Prev)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 09_Time Series
		lineageTag: ts100008-0001-0001-0001-000000000008

	measure 'Customers Growth Arrow' =
			VAR GrowthPct = [Unique Customers YoY %]
			RETURN
				SWITCH(
					TRUE(),
					GrowthPct > 0.01, UNICHAR(9650),
					GrowthPct < -0.01, UNICHAR(9660),
					UNICHAR(9472)
				)
		displayFolder: 14_Viz Helpers
		lineageTag: 608b20ce-bb07-4f75-aa3b-6c0354a01d30

	measure 'RFM Segment Color' =
			VAR Segment = SELECTEDVALUE(FCT_RFM_SEGMENTS[RFM_SEGMENT])
