	measure 'Avg Recency (Days)' = ```
			
			VAR __MaxSnapshotDate = 
			    CALCULATE(
			        MAX(DIM_DATES[DATE]), 
			        ALLSELECTED(DIM_DATES)
			    )
			VAR __FormattedMaxSnapShotDate = (YEAR(__MaxSnapshotDate) * 10000) +(MONTH(__MaxSnapshotDate) * 100) + 01
			
			RETURN
			CALCULATE(
				AVERAGE(FCT_RFM_SEGMENTS[RECENCY_DAYS]),
			    FCT_RFM_SEGMENTS[SNAPSHOT_DATE_KEY] = __FormattedMaxSnapShotDate
			)
			
			```
		formatString: #,##0
		displayFolder: 01_Segments\RFM
		lineageTag: r1000007-0001-0001-0001-000000000007

	measure 'Avg Frequency' = ```
			
			VAR __MaxSnapshotDate = 
			    CALCULATE(
			        MAX(DIM_DATES[DATE]), 
			        ALLSELECTED(DIM_DATES)
			    )
			VAR __FormattedMaxSnapShotDate = (YEAR(__MaxSnapshotDate) * 10000) +(MONTH(__MaxSnapshotDate) * 100) + 01
			
			RETURN
			CALCULATE(
				AVERAGE(FCT_RFM_SEGMENTS[TOTAL_ORDERS]),
			    FCT_RFM_SEGMENTS[SNAPSHOT_DATE_KEY] = __FormattedMaxSnapShotDate
			)
			
			// AVERAGEX(
			// 	KEEPFILTERS(
			// 		VALUES(FCT_RFM_SEGMENTS[CUSTOMER_UNIQUE_ID])
			// 	),
			// 	CALCULATE(
			// 		MAX(FCT_RFM_SEGMENTS[TOTAL_ORDERS])
			// 	)
			// )
			```
		formatString: 0.0
		displayFolder: 01_Segments\RFM
		lineageTag: r1000008-0001-0001-0001-000000000008

	measure 'Avg Monetary' = ```
			
			VAR __MaxSnapshotDate = 
