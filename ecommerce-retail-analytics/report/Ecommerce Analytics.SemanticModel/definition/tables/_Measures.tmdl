	/// Running total of revenue. ALLSELECTED preserves the user's date slicer
	/// (previous ALL(DIM_DATES) ignored slicer scope, producing wrong values when filtered).
	measure 'Cumulative Revenue' =
			CALCULATE(
				[Total Revenue],
				FILTER(
					ALLSELECTED(DIM_DATES[DATE]),
					DIM_DATES[DATE] <= MAX(DIM_DATES[DATE])
				)
			)
		formatString: $#,##0
		displayFolder: 08_Time Intelligence
		lineageTag: 87359a09-a8f0-4bff-915d-b8459844a18d

	measure 'Cumulative Orders' =
			CALCULATE(
				[Total Orders],
				FILTER(
					ALLSELECTED(DIM_DATES[DATE]),
					DIM_DATES[DATE] <= MAX(DIM_DATES[DATE])
				)
			)
		formatString: #,##0
		displayFolder: 08_Time Intelligence
		lineageTag: 2bcc1bb1-d1f0-4cac-a2ac-0c0d1ff83e45

	/// =============================================
	/// _Analytical Measures
	/// =============================================
	/// Customers with exactly 1 order. Uses ADDCOLUMNS + SUMMARIZE keys-only
	/// (modern pattern preferred over SUMMARIZE-with-extension-columns).
	/// Long-term: push IS_SINGLE_PURCHASER flag from dbt (already exists in
	/// FCT_CHURN_RISK) and replace this with CALCULATE(..., flag = TRUE).
	measure 'Single Purchaser Count' =
			VAR _CustomerOrders =
				ADDCOLUMNS(
					SUMMARIZE(FCT_ORDERS, DIM_CUSTOMERS[CUSTOMER_UNIQUE_ID]),
					"@Orders", CALCULATE(COUNTROWS(FCT_ORDERS))
				)
			RETURN
				COUNTROWS(FILTER(_CustomerOrders, [@Orders] = 1))
		formatString: #,##0
		displayFolder: 07_Analytical
		lineageTag: b8bd4d15-a789-4f25-a696-2056dae8a8e2

	measure 'Repeat Purchaser Count' =
			VAR _CustomerOrders =
				ADDCOLUMNS(
					SUMMARIZE(FCT_ORDERS, DIM_CUSTOMERS[CUSTOMER_UNIQUE_ID]),
					"@Orders", CALCULATE(COUNTROWS(FCT_ORDERS))
				)
			RETURN
				COUNTROWS(FILTER(_CustomerOrders, [@Orders] > 1))
		formatString: #,##0
		displayFolder: 07_Analytical
		lineageTag: 9da1b9a1-af61-496a-93f7-5693387636ff

	measure 'Single Purchaser %' = DIVIDE([Single Purchaser Count], [Unique Customers], 0)
		formatString: 0.0%
