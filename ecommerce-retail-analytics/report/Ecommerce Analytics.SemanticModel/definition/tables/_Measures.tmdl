	measure 'Time Series PY' = ```
			
			-- Detect which metric is currently selected on the page
			VAR __IsRevenueActive = ISFILTERED('CG Order Items Metrics'[Orders Metric]) && SELECTEDVALUE('CG Order Items Metrics'[Orders Metric]) = "Revenue"
			VAR __IsOrdersActive  = ISFILTERED('CG Order Items Metrics'[Orders Metric]) && SELECTEDVALUE('CG Order Items Metrics'[Orders Metric]) = "Orders"
			VAR __IsAOVActive     = ISFILTERED('CG Order Items Metrics'[Orders Metric]) && SELECTEDVALUE('CG Order Items Metrics'[Orders Metric]) = "AOV"
			
			-- Calculate the prior year value 
			VAR __PriorYearValue = 
			    CALCULATE(
			        SWITCH(
			            TRUE(),
			            __IsRevenueActive, [Order Items Total Revenue],
			            __IsOrdersActive,  [Order Items Total Orders],
			            __IsAOVActive,     [Order Items AOV],
			            [Order Items Total Revenue]
			        ),
			        SAMEPERIODLASTYEAR(DIM_DATES[DATE]),
			        REMOVEFILTERS(DIM_DATES[YEAR]) -- ignores current year filter
			    )
			
			RETURN
			__PriorYearValue
			```
