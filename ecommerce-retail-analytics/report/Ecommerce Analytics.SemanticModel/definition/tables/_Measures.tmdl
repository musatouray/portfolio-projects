	/// Blended P1 retention rate (weighted by cohort size). Avoids
	/// average-of-averages bias when slicing across multiple cohorts.
	measure 'P1 Retention Rate' =
			
			CALCULATE(
				DIVIDE(
					SUM(FCT_COHORT_RETENTION[ACTIVE_CUSTOMERS]),
					SUM(FCT_COHORT_RETENTION[COHORT_SIZE])
				),
				FCT_COHORT_RETENTION[PERIOD_NUMBER] = 1
			)
		formatString: 0.0%
		displayFolder: 05_Cohort
		lineageTag: 069e8c71-f5f7-4a6c-b6ab-3e1b2263ff83

	measure 'P3 Retention Rate' =
			
			CALCULATE(
				DIVIDE(
					SUM(FCT_COHORT_RETENTION[ACTIVE_CUSTOMERS]),
					SUM(FCT_COHORT_RETENTION[COHORT_SIZE])
				),
				FCT_COHORT_RETENTION[PERIOD_NUMBER] = 3
			)
		formatString: 0.0%
		displayFolder: 05_Cohort
		lineageTag: 0813a708-7bf6-4947-a8d4-8c15ca50ad71

	measure 'P6 Retention Rate' =
			
			CALCULATE(
				DIVIDE(
					SUM(FCT_COHORT_RETENTION[ACTIVE_CUSTOMERS]),
					SUM(FCT_COHORT_RETENTION[COHORT_SIZE])
				),
				FCT_COHORT_RETENTION[PERIOD_NUMBER] = 6
			)
		formatString: 0.0%
		displayFolder: 05_Cohort
		lineageTag: 53ed4aba-f094-4d40-ab85-287682b3a2c6

	/// Difference P1 - P6. Format string fixed (was '0', producing 0 for values < 1).
	measure 'Avg P1-P6 Drop' = [P1 Retention Rate] - [P6 Retention Rate]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05_Cohort
		lineageTag: 4bda322f-7e8b-4f1e-bfc6-523971f75037

	/// Size of the most recent cohort (P0). Stash MAX(COHORT_KEY) in a VAR so
	/// it evaluates once under the outer filter context, then filter the table.
	measure 'Latest Cohort Size' =
			
			VAR _LatestCohort = CALCULATE(MAX(FCT_COHORT_RETENTION[COHORT_KEY]), ALLSELECTED(FCT_COHORT_RETENTION))
			RETURN
				CALCULATE(
					SUM(FCT_COHORT_RETENTION[COHORT_SIZE]),
					KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_KEY] = _LatestCohort),
					KEEPFILTERS(FCT_COHORT_RETENTION[PERIOD_NUMBER] = 0)
				)
		formatString: #,##0
		displayFolder: 05_Cohort
		lineageTag: ab0820fd-6338-40f8-92d7-372b90ed9185

	measure 'Delivered to Reviewed %' = DIVIDE([Orders Reviewed], [Orders Delivered])
		formatString: 0.0%
