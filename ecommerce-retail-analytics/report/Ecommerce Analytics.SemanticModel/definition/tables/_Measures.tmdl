	measure 'CLV Segment %' =
			DIVIDE(
				COUNTROWS(FCT_CLV_CUSTOMER),
				CALCULATE(COUNTROWS(FCT_CLV_CUSTOMER), ALL(FCT_CLV_CUSTOMER[CLV_SEGMENT])),
				0
			)
		formatString: 0.0%
		displayFolder: 01_Segments\CLV
		lineageTag: c1000008-0001-0001-0001-000000000008

	measure 'Avg CLV Decile' = AVERAGE(FCT_CLV_CUSTOMER[CLV_DECILE])
		formatString: 0.0
