	measure 'Total Order Items' = COUNTROWS(VALUES(FCT_ORDER_ITEMS[ORDER_ID]))
		formatString: #,0
		displayFolder: 00_Base\_Order Items
		lineageTag: c63af139-3662-4496-8780-b91061008cb2

	measure 'Rank: Products by Revenue' = ```
			
			VAR __SelectedTopBottomN = SELECTEDVALUE('Top/Bottom Selector'[Top/Bottom N])
			VAR __Revenue = [Total Revenue Order Items]
			
			-- Create a virtual table of all categories where revenue is greatert han 0
			VAR __ActiveCategories = 
			    FILTER(
			        ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			        [Total Revenue Order Items] > 0
			    )
			VAR __TotalCount = COUNTROWS(__ActiveCategories)
			
			-- Top ranking
			VAR __TopRank = 
			    IF(
			        __Revenue > 0 && ISINSCOPE(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			        RANKX(__ActiveCategories, [Total Revenue Order Items], __Revenue, DESC, Dense)
			    )
			
			-- Bottom ranking 
			VAR __BottomRank = 
			    IF(
			        __Revenue > 0 && ISINSCOPE(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			        RANKX(__ActiveCategories, [Total Revenue Order Items], __Revenue, ASC, Dense)
			    )
			
			-- Define the two consecutive middle rows
			VAR __MiddleRankValue1 = INT(__TotalCount / 2)
			VAR __MiddleRankValue2 = __MiddleRankValue1 + 1
			
			VAR __IsMiddleRow = (__TopRank = __MiddleRankValue1 || __TopRank = __MiddleRankValue2)
			
			RETURN 
			    IF(
			        __Revenue > 0 && 
			        (__TopRank <= __SelectedTopBottomN || __BottomRank <= __SelectedTopBottomN || __IsMiddleRow), 
			        1, 
			        0
			    )
			
			```
		displayFolder: 12_Top/Bottom N
		lineageTag: 04bdcdb9-221d-4a37-8b53-71ec20ebb821

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Display Category' = ```
			
			VAR __SelectedTopBottomN = SELECTEDVALUE('Top/Bottom Selector'[Top/Bottom N])
			VAR __Revenue = [Total Revenue Order Items]
			VAR __ActiveCategories = FILTER(ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]), [Total Revenue Order Items] > 0)
			VAR __TotalCount = COUNTROWS(__ActiveCategories)
			VAR __TopRank = RANKX(__ActiveCategories, [Total Revenue Order Items], __Revenue, DESC, Dense)
			
			-- Define the two middle rows
			VAR __MiddleRankValue1 = INT(__TotalCount / 2)
			VAR __MiddleRankValue2 = __MiddleRankValue1 + 1
			
			RETURN
			    IF(
			        __TopRank = __MiddleRankValue1 || __TopRank = __MiddleRankValue2,
			        "⋮", 
			        SELECTEDVALUE(DIM_PRODUCTS[PRODUCT_CATEGORY])
			    )
			
			```
		displayFolder: 12_Top/Bottom N
		lineageTag: 8831e665-ab2f-4240-834a-c982e1110458

		annotation PBI_FormatHint = {"isText":true}

	measure 'Display Rank Number' = ```
			
			VAR __SelectedTopBottomN = SELECTEDVALUE('Top/Bottom Selector'[Top/Bottom N])
			VAR __CurrentRevenue = [Total Revenue Order Items]
			
			-- 1. Create a global active table ignoring the local visual row context
			VAR __GlobalActiveCategories = 
			    CALCULATETABLE(
			        FILTER(
			            ALL(DIM_PRODUCTS[PRODUCT_CATEGORY]), 
			            [Total Revenue Order Items] > 0
			        ),
			        ALLSELECTED() -- Respects date slicers/page filters, ignores the table row filter
			    )
			VAR __TotalCount = COUNTROWS(__GlobalActiveCategories)
			
			-- 2. Compute the exact ranking position in the global context
			VAR __GlobalTopRank = 
			    IF(
			        __CurrentRevenue > 0,
			        RANKX(
			            __GlobalActiveCategories, 
			            [Total Revenue Order Items], 
			            __CurrentRevenue, 
			            DESC, 
			            Dense
			        )
			    )
			    
			VAR __GlobalBottomRank = (__TotalCount - __GlobalTopRank + 1)
			VAR __MiddleRankValue = INT(__TotalCount / 2) + 1
			
			RETURN
			    IF(
			        ISINSCOPE(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			        SWITCH(
			            TRUE(),
			            -- Top N rows 
			            __GlobalTopRank <= __SelectedTopBottomN, 
			            __GlobalTopRank,
			            
			            -- Bottom N rows 
			            __GlobalBottomRank <= __SelectedTopBottomN, 
			            __GlobalTopRank, 
			            
			            -- Middle row stays blank
			            __GlobalTopRank = __MiddleRankValue, 
			            "⋮",
			
			            "⋮"
			        )
			    )
			
			```
		displayFolder: 12_Top/Bottom N
		lineageTag: b73d1c37-36be-4357-8ef4-97b96a2228a5

