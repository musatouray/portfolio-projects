createOrReplace

	table 'CG Custom Periods'
		lineageTag: 4458ecfb-9fdd-49ed-97c6-ed32bb804cf3

		calculationGroup
			precedence: 10

			calculationItem Custom =
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __StartDate = CALCULATE(MIN(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					VAR __EndDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					
					RETURN
					SWITCH(
					    TRUE(),
					    ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					    __IsDimDateFiltered, SELECTEDMEASURE(),
					    CALCULATE(
					        SELECTEDMEASURE(),
					        KEEPFILTERS(
								DATESBETWEEN(DIM_DATES[DATE], __StartDate, __EndDate)
							)
					    )
					)

			calculationItem 'Current Week' = ```
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES)) 
					VAR __StartDate = __LastOrderDate - WEEKDAY(__LastOrderDate, 2) + 1 // Monday is start of the week
					
					RETURN 
					    SWITCH( 
					        TRUE(), 
					        ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					        __IsDimDateFiltered, SELECTEDMEASURE(), 
					        CALCULATE( 
					            SELECTEDMEASURE(), 
					            KEEPFILTERS(
									DATESBETWEEN(DIM_DATES[DATE], __StartDate, __LastOrderDate)
								)
					        ) 
					    )
					```

			calculationItem 'Last Week' = ```
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES)) 
					VAR __startOfWeek = __LastOrderDate - WEEKDAY(__LastOrderDate, 2) + 1 // Monday is start of the week
					VAR __StartDate = __startOfWeek - 7
					VAR __EndDate = __startOfWeek - 1
					
					RETURN 
					    SWITCH( 
					        TRUE(), 
					        ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					        __IsDimDateFiltered, SELECTEDMEASURE(), 
					        CALCULATE( 
					            SELECTEDMEASURE(), 
					            KEEPFILTERS(
									DATESBETWEEN(DIM_DATES[DATE], __StartDate, __EndDate)
								) 
					        ) 
					    )
					```

			calculationItem 'Last 4 Weeks' = ```
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					VAR __startOfWeek = __LastOrderDate - WEEKDAY(__LastOrderDate, 2) + 1 // Monday is start of the week
					VAR __StartDate = __startOfWeek - 28
					VAR __EndDate = __startOfWeek - 1
					
					RETURN 
					    SWITCH( 
					        TRUE(), 
					        ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					        __IsDimDateFiltered, SELECTEDMEASURE(), 
					        CALCULATE( 
					            SELECTEDMEASURE(), 
					            KEEPFILTERS(
									DATESBETWEEN(DIM_DATES[DATE], __StartDate, __EndDate)
								)
					        ) 
					    )
					```

			calculationItem MTD = ```
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES)) 
					VAR __StartDate = DATE(YEAR(__LastOrderDate), MONTH(__LastOrderDate), 1)
					
					RETURN 
					    SWITCH( 
					        TRUE(), 
					        ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					        __IsDimDateFiltered, SELECTEDMEASURE(), 
					        
					        CALCULATE( 
					            SELECTEDMEASURE(), 
					            KEEPFILTERS(
									DATESBETWEEN(DIM_DATES[DATE], __StartDate, __LastOrderDate)
								)
					        ) 
					    )
					```

			calculationItem 'Last Month' =
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					VAR __ShiftedDate = EDATE(__LastOrderDate, -1)
					VAR __StartDate = DATE(YEAR(__ShiftedDate), MONTH(__ShiftedDate), 1)
					VAR __EndDate = EOMONTH(__LastOrderDate, -1)
					
					RETURN
					SWITCH(
					    TRUE(),
					    ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					    __IsDimDateFiltered, SELECTEDMEASURE(),
					    CALCULATE(
					        SELECTEDMEASURE(),
					        KEEPFILTERS(
								DATESBETWEEN(DIM_DATES[DATE], __StartDate, __EndDate)
							)
					    )
					)

			calculationItem QTD =
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					VAR __StartDate = DATE(YEAR(__LastOrderDate), (QUARTER(__LastOrderDate) - 1) * 3 + 1, 1)
					
					RETURN
					SWITCH(
					    TRUE(),
					    ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					    __IsDimDateFiltered, SELECTEDMEASURE(),
					    CALCULATE(
					        SELECTEDMEASURE(),
					        KEEPFILTERS(
								DATESBETWEEN(DIM_DATES[DATE], __StartDate, __LastOrderDate)
							)
					    )
					)

			calculationItem 'Last Quarter' =
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					VAR __StartDate = DATE(YEAR(__LastOrderDate), (QUARTER(__LastOrderDate) - 2) * 3 + 1, 1)
					VAR __EndDate = EOMONTH(DATE(YEAR(__LastOrderDate), (QUARTER(__LastOrderDate) - 2) * 3 + 1, 1), 2)
					
					RETURN
					SWITCH(
					    TRUE(),
					    ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					    __IsDimDateFiltered, SELECTEDMEASURE(),
					    CALCULATE(
					        SELECTEDMEASURE(),
					        KEEPFILTERS(
								DATESBETWEEN(DIM_DATES[DATE], __StartDate, __EndDate)
							)
					    )
					)

			calculationItem 'Last 6 Months' =
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					
					RETURN
					SWITCH(
					    TRUE(),
					    ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					    __IsDimDateFiltered, SELECTEDMEASURE(),
					    CALCULATE(
					        SELECTEDMEASURE(),
							KEEPFILTERS(
								DATESINPERIOD(DIM_DATES[DATE], __LastOrderDate, -6, MONTH)
							)
					    )
					)

			calculationItem 'Last 12 Months' =
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					
					RETURN
					SWITCH(
					    TRUE(),
					    ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					    __IsDimDateFiltered, SELECTEDMEASURE(),
					    CALCULATE(
					        SELECTEDMEASURE(),
							KEEPFILTERS(
								DATESINPERIOD(DIM_DATES[DATE], __LastOrderDate, -12, MONTH)
							)
					    )
					)

			calculationItem YTD =
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					VAR __StartDate = DATE(YEAR(__LastOrderDate), 1, 1)
					
					RETURN
					SWITCH(
					    TRUE(),
					    ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					    __IsDimDateFiltered, SELECTEDMEASURE(),
					    CALCULATE(
					        SELECTEDMEASURE(),
					        KEEPFILTERS(
								DATESBETWEEN(DIM_DATES[DATE], __StartDate, __LastOrderDate)
							)
					    )
					)

			calculationItem 'Last Year' =
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					VAR __StartDate = DATE(YEAR(__LastOrderDate) - 1, 1, 1)
					VAR __EndDate = DATE(YEAR(__StartDate), 12, 31)
					
					RETURN
					SWITCH(
					    TRUE(),
					    ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					    __IsDimDateFiltered, SELECTEDMEASURE(),
					    CALCULATE(
					        SELECTEDMEASURE(),
					        KEEPFILTERS(
								DATESBETWEEN(DIM_DATES[DATE], __StartDate, __EndDate)
							)
					    )
					)

			calculationItem 'All Time' =
					
					VAR __IsDimDateFiltered = CALCULATE(ISFILTERED(DIM_DATES[DATE]), ALLSELECTED(DIM_DATES[DATE]))
					VAR __StartDate = CALCULATE(MIN(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					VAR __LastOrderDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
					
					RETURN
					SWITCH(
					    TRUE(),
					    ISSELECTEDMEASURE([Start and End Dates]), [Start and End Dates],
					    __IsDimDateFiltered, SELECTEDMEASURE(),
					    CALCULATE(
					        SELECTEDMEASURE(),
					        KEEPFILTERS(
								DATESBETWEEN(DIM_DATES[DATE], __StartDate, __LastOrderDate)
							)
					    )
					)

