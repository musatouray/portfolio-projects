createOrReplace

	ref table _Measures

		measure 'Cohort Orders' = ```
				
				VAR __CohortSize = [Param: Cohort Size Value] 
				VAR __CohortAsOfDate = [As on Cohort Date] 
				RETURN 
				CALCULATE( 
				    SUM(FCT_COHORT_RETENTION[PERIOD_ORDERS]), 
				    KEEPFILTERS(DIM_COHORTS[COHORT_MONTH] <= __CohortAsOfDate),
				    KEEPFILTERS(DIM_COHORTS[COHORT_SIZE] >= __CohortSize)
				)
				
				```
			formatString: #,0
			displayFolder: 05_Cohort
			lineageTag: f8becc0c-4dfd-48d3-bb33-28da5cfcaf5f

		measure 'Cohort Revenue' = ```
				
				VAR __CohortSize = [Param: Cohort Size Value] 
				VAR __CohortAsOfDate = [As on Cohort Date] 
				RETURN 
				CALCULATE( 
				    SUM(FCT_COHORT_RETENTION[PERIOD_REVENUE]), 
				    KEEPFILTERS(DIM_COHORTS[COHORT_MONTH] <= __CohortAsOfDate),
				    KEEPFILTERS(DIM_COHORTS[COHORT_SIZE] >= __CohortSize)
				)
				
				```
			formatString: \$#,0;(\$#,0);\$#,0
			displayFolder: 05_Cohort
			lineageTag: 76d6dc3a-0cda-4527-99b7-2e31806df60b

		/// =============================================
		/// _Cohort Retention Measures
		/// =============================================
		measure 'Cohort Size' = ```
				
				VAR __CohortSize = [Param: Cohort Size Value] 
				VAR __CohortAsOfDate = [As on Cohort Date] 
				RETURN 
				CALCULATE( 
				    SUM(FCT_COHORT_RETENTION[COHORT_SIZE]), 
				    KEEPFILTERS(DIM_COHORTS[COHORT_MONTH] <= __CohortAsOfDate),
				    KEEPFILTERS(DIM_COHORTS[COHORT_SIZE] >= __CohortSize)
				)
				
				```
			formatString: #,0
			displayFolder: 05_Cohort
			lineageTag: co100001-0001-0001-0001-000000000001

		measure 'Retained Customers' = ```
				
				VAR __CohortSize = [Param: Cohort Size Value] 
				VAR __CohortAsOfDate = [As on Cohort Date] 
				RETURN 
				CALCULATE( 
				    SUM(FCT_COHORT_RETENTION[ACTIVE_CUSTOMERS]), 
				    KEEPFILTERS(DIM_COHORTS[COHORT_MONTH] <= __CohortAsOfDate),
				    KEEPFILTERS(DIM_COHORTS[COHORT_SIZE] >= __CohortSize)
				)
				
				```
			formatString: #,0
			displayFolder: 05_Cohort
			lineageTag: co100002-0001-0001-0001-000000000002

		measure 'Retention Rate' = ```
				
				DIVIDE([Retained Customers], [Cohort Size], 0)
				
				```
			displayFolder: 05_Cohort
			lineageTag: co100003-0001-0001-0001-000000000003

			formatStringDefinition = ```
					VAR __SelectedMeasure = [Retention Rate]
					RETURN
					IF( 
					    __SelectedMeasure < 1, 
					    "0.00%",
					    "0%"
					)
					```

		/// Complement of Avg Retention Rate, blended by cohort size.
		measure 'Cohort Churn Rate' = 1 - [Retention Rate]
			formatString: 0.0%
			displayFolder: 05_Cohort
			lineageTag: co100005-0001-0001-0001-000000000005

		measure 'Cohort Avg Order Value' =
				
				DIVIDE(
				    [Cohort Revenue],
				    [Cohort Orders],
				    0
				)
			formatString: \$#,0;(\$#,0);\$#,0
			displayFolder: 05_Cohort
			lineageTag: 30948eb7-d33f-41b5-ade2-cdda32eb9cfa

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		measure 'Cohort Avg Customer Value' =
				
				DIVIDE(
					[Cohort Revenue],
					[Cohort Size],
					0
				)
			formatString: \$#,0.0;(\$#,0.0);\$#,0.0
			displayFolder: 05_Cohort
			lineageTag: 7f4b0b52-13ce-439c-b030-c10b686413c0

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

