/// BUSINESS MEANING: Payment-transaction facts - one payment on an order, with method, installments and amount. Use for payment-method mix and installment analysis. GRAIN: one row per payment transaction (order x payment sequence x type); excludes canceled/unavailable orders. RELATIONSHIPS: joins to DIM_CUSTOMERS (CUSTOMER_KEY) and DIM_DATES (order date). Not related to FCT_ORDERS - combine only via shared dimensions.
table FCT_ORDER_PAYMENTS
	lineageTag: 2f8d2dab-28cb-405d-95b4-44d14e7309b5

	/// Payment method used (credit_card, boleto, voucher, debit_card, not_defined). Grain: per payment transaction.
	column PAYMENT_TYPE
		dataType: string
		lineageTag: 334d0c4f-a11e-4942-ad28-818ad4b4ad94
		summarizeBy: none
		sourceColumn: PAYMENT_TYPE

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

