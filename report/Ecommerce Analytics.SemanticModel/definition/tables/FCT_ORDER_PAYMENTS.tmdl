	column ORDER_PAYMENT_KEY
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 4f7890a1-ddea-433e-ae64-573d1fe33be9
		summarizeBy: none
		sourceColumn: ORDER_PAYMENT_KEY

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

