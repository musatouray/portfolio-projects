		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 478d0f75-6885-47a3-8163-040cbd22c5f2
		summarizeBy: none
		sourceColumn: M_SCORE

		annotation SummarizationSetBy = Automatic

	/// Customer's RFM business segment at the snapshot (Champions, New Customers, Loyal Customers, Potential Loyalists, At Risk, Hibernating, Need Attention, Lost). Grain: per customer per snapshot month.
	column RFM_SEGMENT
		dataType: string
		lineageTag: 68d83f58-3e72-429e-9f71-8543c773bfc0
		summarizeBy: none
		sourceColumn: RFM_SEGMENT
		sortByColumn: SEGMENT_INDEX

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	/// Join to DIM_CUSTOMERS. Grain: per customer per snapshot month.
	column CUSTOMER_KEY
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: c59f50bd-b787-4755-91f0-bc708d81a311
		summarizeBy: none
		sourceColumn: CUSTOMER_KEY

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Month-end as-of date the snapshot describes; defines the time grain. Grain: the snapshot month.
	column SNAPSHOT_MONTH
		dataType: dateTime
		formatString: Short Date
		lineageTag: ecc89f95-83aa-4bee-ac21-2e49337435b7
		summarizeBy: none
		sourceColumn: SNAPSHOT_MONTH

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

