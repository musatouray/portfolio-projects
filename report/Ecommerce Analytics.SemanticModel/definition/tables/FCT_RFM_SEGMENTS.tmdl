	column RECENCY_DAYS
		dataType: int64
		formatString: 0
		lineageTag: e80cf489-8a25-40fc-9ae4-2bffe8004365
		summarizeBy: none
		sourceColumn: RECENCY_DAYS

		annotation SummarizationSetBy = Automatic

	/// Cumulative orders by the customer through the snapshot month (not per-period). Grain: per customer per snapshot month.
	column TOTAL_ORDERS
		dataType: int64
		formatString: 0
