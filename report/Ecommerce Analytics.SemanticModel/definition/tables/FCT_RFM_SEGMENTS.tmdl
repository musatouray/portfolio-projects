/// BUSINESS MEANING: Monthly customer-health snapshots combining RFM scoring with churn-risk metrics; use for segmentation, segment migration over time, and churn analysis. GRAIN: one row per customer per snapshot month; metrics are cumulative to that month-end (not per-period). RELATIONSHIPS: joins to DIM_CUSTOMERS (CUSTOMER_KEY) and to DIM_DATES on the snapshot month (SNAPSHOT_DATE_KEY). Excludes canceled/unavailable orders.
table FCT_RFM_SEGMENTS
	lineageTag: 5d5cd826-5672-4bef-93ed-7b84e9a2a9ee

	/// Recency score 1-5 (5=most recent) at the snapshot month. Grain: per customer per snapshot month.
	column R_SCORE
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: ff68920f-034e-4c63-8491-6a6ab8dae151
		summarizeBy: none
		sourceColumn: R_SCORE

		annotation SummarizationSetBy = Automatic

	/// Frequency score 1-5 (5=most frequent) at the snapshot month. Grain: per customer per snapshot month.
	column F_SCORE
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: d5dee23b-64f7-482c-89ad-621d16da7ffc
		summarizeBy: none
		sourceColumn: F_SCORE

		annotation SummarizationSetBy = Automatic

	/// Monetary score 1-5 (5=highest spend) at the snapshot month. Grain: per customer per snapshot month.
	column M_SCORE
