/// BUSINESS MEANING: Container table that holds all report DAX measures organized into display folders; carries no data. GRAIN: not applicable (zero-row calculated table). RELATIONSHIPS: none.
table _Measures
	lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567890

	/// [METRIC] Primary revenue KPI: total customer payments collected = SUM(FCT_ORDERS[TOTAL_PAYMENT_VALUE]). Additive; aggregates to any grain in filter context (date, customer, geography). Currency BRL.
	measure 'Total Revenue' = SUM(FCT_ORDERS[TOTAL_PAYMENT_VALUE])
		displayFolder: 00_Base\Fct_Orders
		lineageTag: b1000001-0001-0001-0001-000000000001

		formatStringDefinition = ```
				VAR __FormattedRevenue = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __FormattedRevenue <= 1E3, "$#,0.;-#,0.;0",
				        __FormattedRevenue <= 1E4, "$#,0,.00K;-#,0,.00K;0",
				        __FormattedRevenue <= 1E5, "$#,0,.0K;-#,0,.0K;0",
				        __FormattedRevenue <= 1E6, "$#,0,.K;-#,0,.K;0",
				        __FormattedRevenue <= 1E7, "$#,0,,.00M;-#,0,,.00M;0",
				        __FormattedRevenue <= 1E8, "$#,0,,.0M;-#,0,,.0M;0",
				        __FormattedRevenue <= 1E9, "$#,0,,.M;-#,0,,.M;0"
				    )
				
				```

	/// [METRIC] Order volume: COUNTROWS(FCT_ORDERS) in filter context. One count per order.
	measure 'Total Orders' = COUNTROWS(FCT_ORDERS)
		displayFolder: 00_Base\Fct_Orders
		lineageTag: b1000002-0001-0001-0001-000000000002

		formatStringDefinition =
				VAR __FormattedOrders = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __FormattedOrders <= 1E3, "#,0;-#,0;0",
				        __FormattedOrders <= 1E4, "#,0,K;-#,0,K;0",
				        __FormattedOrders <= 1E5, "#,0,K;-#,0,K;0",
				        __FormattedOrders <= 1E6, "#,0,K;-#,0,K;0",
				        __FormattedOrders <= 1E7, "#,0,,M;-#,0,,M;0",
				        __FormattedOrders <= 1E8, "#,0,,M;-#,0,,M;0",
				        __FormattedOrders <= 1E9, "#,0,,M;-#,0,,M;0"
				    )

	/// [METRIC] Distinct customers who purchased, in filter context (DISTINCTCOUNT of customer key). Non-additive across time.
	measure 'Unique Customers' = DISTINCTCOUNT(FCT_ORDER_ITEMS[CUSTOMER_KEY])
		displayFolder: 00_Base\Fct_Orders
		lineageTag: b1000003-0001-0001-0001-000000000003

		formatStringDefinition =
				VAR __UniqueCustomers = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __UniqueCustomers <= 1E3, "#,0;-#,0;0",
				        __UniqueCustomers <= 1E4, "#,0,K;-#,0,K;0",
				        __UniqueCustomers <= 1E5, "#,0,K;-#,0,K;0",
				        __UniqueCustomers <= 1E6, "#,0,K;-#,0,K;0",
				        __UniqueCustomers <= 1E7, "#,0,,M;-#,0,,M;0",
				        __UniqueCustomers <= 1E8, "#,0,,M;-#,0,,M;0",
				        __UniqueCustomers <= 1E9, "#,0,,M;-#,0,,M;0"
				    )

	/// [METRIC] AOV = Total Revenue / Total Orders in filter context (BRL per order).
	measure 'Average Order Value' = DIVIDE([Total Revenue], [Total Orders], 0)
		displayFolder: 00_Base\Fct_Orders
		lineageTag: b1000004-0001-0001-0001-000000000004

		formatStringDefinition =
				VAR __FormattedAOV = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __FormattedAOV <= 1E3, "$#,0.0;-#,0.0;0",
				        __FormattedAOV <= 1E4, "$#,0,.00K;-#,0,.00K;0",
				        __FormattedAOV <= 1E5, "$$#,0,.0K;-#,0,.0K;0",
				        __FormattedAOV <= 1E6, "$#,0,.0K;-#,0,.0K;0",
				        __FormattedAOV <= 1E7, "$#,0,,.00M;-#,0,,.00M;0",
				        __FormattedAOV <= 1E8, "$#,0,,.0M;-#,0,,.0M;0",
				        __FormattedAOV <= 1E9, "$#,0,,.M;-#,0,,.M;0"
				    )

	/// [METRIC] Mean order review score (1-5) over FCT_ORDERS in filter context.
	measure 'Average Review Score' = AVERAGE(FCT_ORDERS[REVIEW_SCORE])
		formatString: 0.0
		displayFolder: 00_Base\Fct_Orders
		lineageTag: b1000005-0001-0001-0001-000000000005

	/// [METRIC] Total freight/shipping charged = SUM(FCT_ORDERS[TOTAL_FREIGHT_VALUE]) in filter context (BRL).
	measure 'Total Freight' = SUM(FCT_ORDERS[TOTAL_FREIGHT_VALUE])
		formatString: $#,##0
		displayFolder: 00_Base\Fct_Orders
		lineageTag: b1000006-0001-0001-0001-000000000006

	/// [METRIC] Share of orders with status 'delivered' among all orders in filter context (percentage).
	measure 'Delivery Rate' =
			
			VAR __TotalOrders = [Total Orders]
			VAR __DeliveredOrders = CALCULATE([Total Orders], FCT_ORDERS[ORDER_STATUS] = "delivered")
			RETURN
			DIVIDE(
				__DeliveredOrders,
				__TotalOrders,
			    0
			)
		formatString: 0.0%
		displayFolder: 00_Base\Fct_Orders
		lineageTag: b1000007-0001-0001-0001-000000000007

	/// [METRIC] Of delivered orders, the share delivered on or before the estimated date, in filter context (percentage).
	measure 'On-Time Delivery Rate' = ```
			
			VAR __TotalOrdersDelivered = 
			    CALCULATE(
			        [Total Orders], 
			        FCT_ORDERS[ORDER_STATUS] = "delivered"
			    )
			
			VAR _OnTimeOrdersDelivered = 
			    CALCULATE(
			        [Total Orders], 
			        FCT_ORDERS[IS_ON_TIME_DELIVERY] = TRUE(), 
			        FCT_ORDERS[ORDER_STATUS] = "delivered"
			    )
			
			RETURN
			DIVIDE(
				_OnTimeOrdersDelivered,
				__TotalOrdersDelivered
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 00_Base\Fct_Orders
		lineageTag: b1000008-0001-0001-0001-000000000008

	/// [METRIC / time-intelligence] Same-period-last-year Total Revenue; requires a DIM_DATES selection to compare current vs prior year.
	measure 'Prior Year Revenue' = ```
			
			// Using UDF function to dynamically calculate SPLY
			TimeIntelligence.PY([Total Revenue])
			
			```
		displayFolder: 08_Time Intelligence\_PY\Fct_Orders
		lineageTag: t1000005-0001-0001-0001-000000000005

		formatStringDefinition = ```
				VAR __FormattedRevenue = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __FormattedRevenue <= 1E3, "$#,0.;-#,0.;0",
				        __FormattedRevenue <= 1E4, "$#,0,.00K;-#,0,.00K;0",
				        __FormattedRevenue <= 1E5, "$$#,0,.0K;-#,0,.0K;0",
				        __FormattedRevenue <= 1E6, "$#,0,.K;-#,0,.K;0",
				        __FormattedRevenue <= 1E7, "$#,0,,.00M;-#,0,,.00M;0",
				        __FormattedRevenue <= 1E8, "$#,0,,.0M;-#,0,,.0M;0",
				        __FormattedRevenue <= 1E9, "$#,0,,.M;-#,0,,.M;0"
				    )
				
				```

	/// [METRIC / time-intelligence] Year-over-year % change of Total Revenue vs the same period last year.
	measure 'Revenue YoY %' = ```
			
			VAR CurrentPeriod = [Total Revenue]
			VAR PriorYear = [Prior Year Revenue]
			
			RETURN 
			DIVIDE(CurrentPeriod - PriorYear, PriorYear, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08_Time Intelligence\_YoY\Fct_Orders
		lineageTag: t1000007-0001-0001-0001-000000000007

	/// [METRIC / time-intelligence] Same-period-last-year Total Orders.
	measure 'Prior Year Orders' = ```
			
			// Using UDF function to dynamically calculate SPLY
			TimeIntelligence.PY([Total Orders])
			
			```
		displayFolder: 08_Time Intelligence\_PY\Fct_Orders
		lineageTag: t1000010-0001-0001-0001-000000000010

		formatStringDefinition =
				VAR __FormattedOrders = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __FormattedOrders <= 1E3, "#,0;-#,0;0",
				        __FormattedOrders <= 1E4, "#,0,K;-#,0,K;0",
				        __FormattedOrders <= 1E5, "#,0,K;-#,0,K;0",
				        __FormattedOrders <= 1E6, "#,0,K;-#,0,K;0",
				        __FormattedOrders <= 1E7, "#,0,,M;-#,0,,M;0",
				        __FormattedOrders <= 1E8, "#,0,,M;-#,0,,M;0",
				        __FormattedOrders <= 1E9, "#,0,,M;-#,0,,M;0"
				    )

	/// [METRIC / time-intelligence] Year-over-year % change of Total Orders.
	measure 'Orders YoY %' = ```
			
			VAR CurrentPeriod = [Total Orders]
			VAR PriorYear = [Prior Year Orders]
			
			RETURN 
			DIVIDE(CurrentPeriod - PriorYear, PriorYear, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08_Time Intelligence\_YoY\Fct_Orders
		lineageTag: t1000011-0001-0001-0001-000000000011

	/// [METRIC] Average days-since-last-purchase across customers at the latest (or slicer-selected) snapshot month in FCT_RFM_SEGMENTS. Lower = more recent.
	measure 'Avg Recency (Days)' = ```
			
			VAR __LatestSnapshotMonth = MAX(DIM_DATES[MONTH_START_DATE]) 
			RETURN 
			    IF(
			        NOT(ISBLANK(__LatestSnapshotMonth)),
			        CALCULATE( 
			            AVERAGE(FCT_RFM_SEGMENTS[RECENCY_DAYS]), 
			            FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshotMonth,
			            REMOVEFILTERS(DIM_DATES)
			        ) 
			    )
			```
		formatString: #,##0
		displayFolder: 01_Segments\RFM
		lineageTag: r1000007-0001-0001-0001-000000000007

	/// [METRIC] Average lifetime order count per customer at the latest snapshot month.
	measure 'Avg Frequency' = ```
			
			VAR __LatestSnapshotMonth = MAX(DIM_DATES[MONTH_START_DATE])
			RETURN 
			    IF(
			        NOT(ISBLANK(__LatestSnapshotMonth)),
			        CALCULATE( 
			            AVERAGE(FCT_RFM_SEGMENTS[TOTAL_ORDERS]), 
			            FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshotMonth,
			            REMOVEFILTERS(DIM_DATES)
			        ) 
			    )
			```
		formatString: 0.0
		displayFolder: 01_Segments\RFM
		lineageTag: r1000008-0001-0001-0001-000000000008

	/// [METRIC] Average lifetime revenue per customer at the latest snapshot month (BRL).
	measure 'Avg Monetary' = ```
			
			VAR __LatestSnapshotMonth = MAX(DIM_DATES[MONTH_START_DATE])
			RETURN 
			    IF(
			        NOT(ISBLANK(__LatestSnapshotMonth)),
			        CALCULATE( 
			            AVERAGE(FCT_RFM_SEGMENTS[TOTAL_REVENUE]), 
			            FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshotMonth,
			            REMOVEFILTERS(DIM_DATES)
			        ) 
			    )
			
			```
		formatString: $#,##0
		displayFolder: 01_Segments\RFM
		lineageTag: r1000009-0001-0001-0001-000000000009

	/// [METRIC] Sum of realized lifetime revenue across customers (FCT_CLV_CUSTOMER[TOTAL_LIFETIME_REVENUE]) in filter context (BRL). Grain: per customer, summed.
	measure 'Total Historical CLV' = SUM(FCT_CLV_CUSTOMER[TOTAL_LIFETIME_REVENUE])
		formatString: $#,##0
		displayFolder: 01_Segments\CLV
		lineageTag: c1000001-0001-0001-0001-000000000001

	/// [METRIC] Sum of 12-month predicted customer value across customers (BRL).
	measure 'Total Predicted CLV' = SUM(FCT_CLV_CUSTOMER[PREDICTED_CLV_12M])
		formatString: $#,##0
		displayFolder: 01_Segments\CLV
		lineageTag: c1000003-0001-0001-0001-000000000003

	/// [METRIC] Count of customers in the high_value CLV segment in filter context.
	measure 'High Value Customers' =
			
			CALCULATE(
				COUNTROWS(FCT_CLV_CUSTOMER),
				FCT_CLV_CUSTOMER[CUSTOMER_VALUE_SEGMENT] = "high_value"
			)
		formatString: #,##0
		displayFolder: 01_Segments\CLV
		lineageTag: c1000005-0001-0001-0001-000000000005

	/// [METRIC] Count of customers in the medium_value CLV segment in filter context.
	measure 'Medium Value Customers' =
			
			CALCULATE(
				COUNTROWS(FCT_CLV_CUSTOMER),
				FCT_CLV_CUSTOMER[CUSTOMER_VALUE_SEGMENT] = "medium_value"
			)
		formatString: #,##0
		displayFolder: 01_Segments\CLV
		lineageTag: c1000006-0001-0001-0001-000000000006

	/// [METRIC] Count of customers in the low_value CLV segment in filter context.
	measure 'Low Value Customers' =
			
			CALCULATE(
				COUNTROWS(FCT_CLV_CUSTOMER),
				FCT_CLV_CUSTOMER[CUSTOMER_VALUE_SEGMENT] = "low_value"
			)
		formatString: #,##0
		displayFolder: 01_Segments\CLV
		lineageTag: c1000007-0001-0001-0001-000000000007

	/// [METRIC] Customers in the qualifying acquisition cohorts (respects the cohort-size and as-of-date what-if parameters). Grain: per cohort.
	measure 'Cohort Size' = ```
			
			VAR __CohortSize = [Param: Cohort Size Value] 
			VAR __CohortAsOfDate = [As on Cohort Date] 
			RETURN 
			CALCULATE( 
			    SUM(FCT_COHORT_RETENTION[COHORT_SIZE]), 
			   // FCT_COHORT_RETENTION[PERIOD_NUMBER] = 0,
			    KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_MONTH] <= __CohortAsOfDate),
			    KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_SIZE] >= __CohortSize)
			)
			
			```
		formatString: #,0
		displayFolder: 05_Cohort
		lineageTag: co100001-0001-0001-0001-000000000001

	/// [METRIC] Active customers from the cohort still purchasing in the period (grain: cohort x period).
	measure 'Retained Customers' = ```
			
			VAR __CohortSize = [Param: Cohort Size Value] 
			VAR __CohortAsOfDate = [As on Cohort Date] 
			RETURN 
			CALCULATE( 
			    SUM(FCT_COHORT_RETENTION[ACTIVE_CUSTOMERS]), 
			    KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_MONTH] <= __CohortAsOfDate),
			    KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_SIZE] >= __CohortSize)
			)
			
			```
		formatString: #,0
		displayFolder: 05_Cohort
		lineageTag: co100002-0001-0001-0001-000000000002

	/// [METRIC] Retained Customers / Cohort Size (cohort retention %); size-weighted when sliced across cohorts.
	measure 'Retention Rate' = ```
			
			DIVIDE([Retained Customers], [Cohort Size], 0)
			
			```
		displayFolder: 05_Cohort
		lineageTag: co100003-0001-0001-0001-000000000003

		formatStringDefinition = ```
				IF( 
				    SELECTEDMEASURE() < 1, 
				    "0.00%",
				    "0%"
				)
				```

	/// [METRIC] 1 - Retention Rate for the cohort-period.
	measure 'Cohort Churn Rate' = 1 - [Retention Rate]
		formatString: 0.0%
		displayFolder: 05_Cohort
		lineageTag: co100005-0001-0001-0001-000000000005

	/// [METRIC] Distinct cohort-period records in filter context.
	measure 'Total Cohorts' = DISTINCTCOUNT(FCT_COHORT_RETENTION[COHORT_RETENTION_KEY])
		formatString: #,##0
		displayFolder: 05_Cohort
		lineageTag: co100006-0001-0001-0001-000000000006

	/// [METRIC] Total orders placed in filter context. Top of the order lifecycle funnel.
	measure 'Orders Placed' = [Total Orders]
		formatString: #,##0
		displayFolder: 04_Funnel
		lineageTag: f1000001-0001-0001-0001-000000000001

	/// [METRIC] Cumulative order-items revenue across product categories in descending order (Pareto/ABC curve).
	measure 'Running Total Product Revenue' = ```
			
			CALCULATE(
			    [Order Items Total Revenue],
			    WINDOW(
			        1, ABS,
			        0, REL,
			        ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			        ORDERBY([Order Items Total Revenue], DESC)
			    )
			)
			
			```
		displayFolder: 03_Product
		lineageTag: p1000001-0001-0001-0001-000000000001

		formatStringDefinition = ```
				VAR __FormattedRevenue = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __FormattedRevenue <= 1E3, "$#,0.;-#,0.;0",
				        __FormattedRevenue <= 1E4, "$#,0,.00K;-#,0,.00K;0",
				        __FormattedRevenue <= 1E5, "$#,0,.0K;-#,0,.0K;0",
				        __FormattedRevenue <= 1E6, "$#,0,.K;-#,0,.K;0",
				        __FormattedRevenue <= 1E7, "$#,0,,.00M;-#,0,,.00M;0",
				        __FormattedRevenue <= 1E8, "$#,0,,.0M;-#,0,,.0M;0",
				        __FormattedRevenue <= 1E9, "$#,0,,.M;-#,0,,.M;0"
				    )
				
				```

	/// [METRIC] Cumulative order-items revenue as a running share of the selected total (Pareto curve).
	measure 'Running Total Product Revenue %' = ```
			
			VAR __AllSelectedRevenue =
			    CALCULATE(
			        [Order Items Total Revenue],
			        ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY])
			    )
			
			VAR __CategoryTable = 
			    ADDCOLUMNS(
			        ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			        "@CategoryRevenue", [Order Items Total Revenue]
			    )
			
			VAR __RunningTotalRevenue =
			SUMX(
			    WINDOW(
			        1, ABS,
			        0, REL,
			        __CategoryTable,
			        ORDERBY([@CategoryRevenue], DESC)
			    ),
			    [@CategoryRevenue]
			)
			
			RETURN
			    DIVIDE( __RunningTotalRevenue, __AllSelectedRevenue, 0 )
			    
			```
		displayFolder: 03_Product
		lineageTag: p1000007-0001-0001-0001-000000000007

		formatStringDefinition = "0.0%"

	/// [METRIC] Count of product pairs (COUNTROWS FCT_MARKET_BASKET) in filter context.
	measure 'Total Product Pairs' = COUNTROWS(FCT_MARKET_BASKET)
		formatString: #,##0
		displayFolder: 06_Market Basket
		lineageTag: m1000001-0001-0001-0001-000000000001

	/// Average support across pairs in context: pair_count / total orders (dataset-wide denominator, date-filter-independent).
	measure 'Avg Support %' =
			VAR __TotalOrders = CALCULATE([Total Orders], REMOVEFILTERS(DIM_DATES))
			RETURN
				AVERAGEX(
					FCT_MARKET_BASKET,
					DIVIDE(FCT_MARKET_BASKET[PAIR_COUNT], __TotalOrders)
				)
		formatString: 0.00%
		displayFolder: 06_Market Basket
		lineageTag: m1000002-0001-0001-0001-000000000002

	/// Average confidence across pairs in context: pair_count / product_a_order_count (self-contained in table, no external denominator needed).
	measure 'Avg Confidence %' =
			AVERAGEX(
				FCT_MARKET_BASKET,
				DIVIDE(
					FCT_MARKET_BASKET[PAIR_COUNT],
					FCT_MARKET_BASKET[PRODUCT_A_ORDER_COUNT]
				)
			)
		formatString: 0.0%
		displayFolder: 06_Market Basket
		lineageTag: m1000003-0001-0001-0001-000000000003

	/// Average lift across pairs in context: (pair_count * total_orders) / (count_a * count_b); >1 = positive affinity.
	measure 'Avg Lift' =
			
			VAR __TotalOrders = CALCULATE([Total Orders], REMOVEFILTERS(DIM_DATES))
			RETURN
				AVERAGEX(
					FCT_MARKET_BASKET,
					DIVIDE(
						FCT_MARKET_BASKET[PAIR_COUNT] * __TotalOrders,
						FCT_MARKET_BASKET[PRODUCT_A_ORDER_COUNT] * FCT_MARKET_BASKET[PRODUCT_B_ORDER_COUNT]
					)
				)
		formatString: 0.00
		displayFolder: 06_Market Basket
		lineageTag: m1000004-0001-0001-0001-000000000004

	/// Count of product pairs with lift above 1.5 (strong affinity). Lift computed from atomic counts.
	measure 'High Lift Pairs' =
			VAR __TotalOrders = CALCULATE([Total Orders], REMOVEFILTERS(DIM_DATES))
			RETURN
				COUNTROWS(
					FILTER(
						FCT_MARKET_BASKET,
						DIVIDE(
							FCT_MARKET_BASKET[PAIR_COUNT] * __TotalOrders,
							FCT_MARKET_BASKET[PRODUCT_A_ORDER_COUNT] * FCT_MARKET_BASKET[PRODUCT_B_ORDER_COUNT]
						) > 1.5
					)
				)
		formatString: #,##0
		displayFolder: 06_Market Basket
		lineageTag: m1000005-0001-0001-0001-000000000005

	/// [METRIC] Total co-purchase occurrences = SUM(FCT_MARKET_BASKET[PAIR_COUNT]) in filter context.
	measure 'Total Pair Occurrences' = SUM(FCT_MARKET_BASKET[PAIR_COUNT])
		formatString: #,##0
		displayFolder: 06_Market Basket
		lineageTag: m1000006-0001-0001-0001-000000000006

	/// Actionable cross-sell pairs: lift > 1 (positive affinity) AND confidence > 10% (reliable recommendation).
	measure 'Cross-Sell Opportunities' =
			VAR __TotalOrders = CALCULATE([Total Orders], REMOVEFILTERS(DIM_DATES))
			RETURN
				COUNTROWS(
					FILTER(
						FCT_MARKET_BASKET,
						DIVIDE(
							FCT_MARKET_BASKET[PAIR_COUNT] * __TotalOrders,
							FCT_MARKET_BASKET[PRODUCT_A_ORDER_COUNT] * FCT_MARKET_BASKET[PRODUCT_B_ORDER_COUNT]
						) > 1
						&&
						DIVIDE(
							FCT_MARKET_BASKET[PAIR_COUNT],
							FCT_MARKET_BASKET[PRODUCT_A_ORDER_COUNT]
						) > 0.1
					)
				)
		formatString: #,##0
		displayFolder: 06_Market Basket
		lineageTag: m1000007-0001-0001-0001-000000000007

	/// =============================================
	/// _Geographic Measures
	/// =============================================
	measure 'Geo Revenue' = SUM(FCT_GEO_PERFORMANCE[TOTAL_REVENUE])
		formatString: $#,##0
		displayFolder: 10_Geographic
		lineageTag: g1000001-0001-0001-0001-000000000001

	measure 'Geo Orders' = SUM(FCT_GEO_PERFORMANCE[TOTAL_ORDERS])
		formatString: #,##0
		displayFolder: 10_Geographic
		lineageTag: g1000002-0001-0001-0001-000000000002

	/// [HELPER] KPI-card display string combining Total Revenue with its YoY change; formatting only. Not a business metric - use Total Revenue / Revenue YoY %.
	measure 'Formatted Revenue Absolute and Relative' = ```
			
			// Using UDF Function
			Format.YoYAbsoluteAndRelative([Total Revenue], [Prior Year Revenue])
			
			```
		formatString: @
		displayFolder: 14_Viz Helpers\_KPI Cards\Fct_Orders
		lineageTag: c02e2e7c-0b31-489e-837f-27310bb80b03

		annotation PBI_FormatHint = {"isText":true}

	/// [HELPER] Conditional-formatting font color for Revenue YoY (green up / red down). Not a business metric.
	measure 'Revenue YoY Font Color' = ```
			
			// Using UDF color function with 0% transparency
			Color.YoYGrowthPct([Revenue YoY %], 0) 
			
			```
		formatString: @
		displayFolder: 14_Viz Helpers\_Color
		lineageTag: 836359c6-cea0-476f-ba67-353adb77f623

		annotation PBI_FormatHint = {"isText":true}

	/// [HELPER] KPI-card display string for Total Orders + YoY; formatting only. Not a business metric.
	measure 'Formatted Orders Absolute And Relative' = ```
			
			// Using UDF Function
			Format.YoYAbsoluteAndRelative([Total Orders], [Prior Year Orders])
			 
			```
		formatString: @
