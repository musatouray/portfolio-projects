	/// [HELPER] Dynamic title reflecting the selected metric and period. Not a business metric.
	measure 'Selected Metric Title' = ```
			
			VAR __SelectedMetric = SELECTEDVALUE('CG Selected Metric'[Metric])
			VAR __SelectedPeriod = SELECTEDVALUE('CG Custom Periods'[Period])
			VAR __Space = REPT(UNICHAR(160), 3)
			
			RETURN
			SWITCH(
			    __SelectedMetric,
			    "Orders", "Orders " & __Space & " | " & __Space & IF( __SelectedPeriod <> "Custom", __SelectedPeriod),
			    "Revenue", "Revenue " & __Space & " | " & __Space & IF( __SelectedPeriod <> "Custom", __SelectedPeriod),
			    "AOV", "Average Order Value " & __Space & " | " & __Space & IF( __SelectedPeriod <> "Custom", __SelectedPeriod)
			)
			
			```
