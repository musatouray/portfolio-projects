			VAR __SelectedCategoryCount = COUNTROWS(VALUES(DIM_PRODUCTS[PRODUCT_CATEGORY]))
			
			VAR __SelectedProductsText =
			    SWITCH(
			        TRUE(),
			        __SelectedCategoryCount = __AllCategoryCount, "All Products",
			        CONCATENATEX(
			            VALUES(DIM_PRODUCTS[PRODUCT_CATEGORY]),
			            DIM_PRODUCTS[PRODUCT_CATEGORY],
			            ", "
			        )
			    )
			RETURN
