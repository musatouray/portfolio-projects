	/// [METRIC] Count of orders with ORDER_STATUS = 'delivered'. Bottom of the order lifecycle funnel.
	measure 'Orders Delivered' = CALCULATE([Total Orders], FCT_ORDERS[ORDER_STATUS] = "delivered")
		formatString: #,##0
		displayFolder: 04_Funnel
		lineageTag: f1000002-0001-0001-0001-000000000002

	/// [METRIC] Count of orders with ORDER_STATUS = 'canceled'.
	measure 'Orders Canceled' = CALCULATE([Total Orders], FCT_ORDERS[ORDER_STATUS] = "canceled")
		formatString: #,##0
		displayFolder: 04_Funnel
		lineageTag: f1000003-0001-0001-0001-000000000003

	/// [METRIC] Count of orders that have not been canceled or marked unavailable.
	measure 'Orders Active' = CALCULATE(COUNTROWS(FCT_ORDERS), NOT FCT_ORDERS[ORDER_STATUS] IN {"canceled", "unavailable"})
		formatString: #,##0
		displayFolder: 04_Funnel
		lineageTag: f1000004-0001-0001-0001-000000000004

	/// [METRIC] Count of orders with ORDER_STATUS IN ('shipped', 'delivered').
	measure 'Orders Shipped' = CALCULATE(COUNTROWS(FCT_ORDERS), FCT_ORDERS[ORDER_STATUS] IN {"shipped", "delivered"})
		formatString: #,##0
		displayFolder: 04_Funnel
		lineageTag: f1000005-0001-0001-0001-000000000005

	/// [METRIC] Count of delivered orders that have at least one review submitted.
	measure 'Orders Reviewed' = CALCULATE(COUNTROWS(FCT_ORDERS), FCT_ORDERS[REVIEW_COUNT] > 0)
		formatString: #,##0
		displayFolder: 04_Funnel
		lineageTag: f1000006-0001-0001-0001-000000000006

	/// [METRIC] Share of orders that were canceled = Orders Canceled / Orders Placed.
	measure 'Order Cancellation Rate' =
			DIVIDE(
			    CALCULATE(COUNTROWS(FCT_ORDERS), FCT_ORDERS[ORDER_STATUS] = "canceled"),
			    [Total Orders]
			)
		formatString: 0.00%
		displayFolder: 04_Funnel
		lineageTag: f1000007-0001-0001-0001-000000000007

	/// [METRIC] Share of delivered orders that have a review.
	measure 'Order Review Rate' = DIVIDE([Orders Reviewed], [Orders Delivered])
		formatString: 0.0%
		displayFolder: 04_Funnel
		lineageTag: f1000008-0001-0001-0001-000000000008

	/// [METRIC] Average days from order placement to delivery, for delivered orders only.
	measure 'Avg Delivery Days' = CALCULATE(AVERAGE(FCT_ORDERS[DELIVERY_DAYS]), FCT_ORDERS[ORDER_STATUS] = "delivered")
		formatString: 0.0
		displayFolder: 04_Funnel
		lineageTag: 5835c374-6158-4194-9a0e-5103b529af65

	/// [METRIC] Average days from order approval to delivery (warehouse + transit), for delivered orders.
	measure 'Avg Fulfillment Days' = CALCULATE(AVERAGE(FCT_ORDERS[FULFILLMENT_DAYS]), FCT_ORDERS[ORDER_STATUS] = "delivered")
		formatString: 0.0
		displayFolder: 04_Funnel
		lineageTag: f1000009-0001-0001-0001-000000000009

	/// [METRIC] Average days from carrier pickup to customer delivery, for delivered orders.
	measure 'Avg Transit Days' = CALCULATE(AVERAGE(FCT_ORDERS[SHIPPING_TRANSIT_DAYS]), FCT_ORDERS[ORDER_STATUS] = "delivered")
		formatString: 0.0
		displayFolder: 04_Funnel
		lineageTag: f1998e3e-bc2a-4ef9-b0d4-d036cc73106e

	/// [METRIC] Average days from order placement to warehouse approval.
	measure 'Avg Approval Wait Days' =
			CALCULATE(
			    AVERAGEX(
			        FILTER(FCT_ORDERS,
			            FCT_ORDERS[ORDER_STATUS] = "delivered"
			            && NOT ISBLANK(FCT_ORDERS[DELIVERY_DAYS])
			            && NOT ISBLANK(FCT_ORDERS[FULFILLMENT_DAYS])
			        ),
			        FCT_ORDERS[DELIVERY_DAYS] - FCT_ORDERS[FULFILLMENT_DAYS]
			    )
			)
		formatString: 0.0
		displayFolder: 04_Funnel
		lineageTag: f1000010-0001-0001-0001-000000000010

	/// [METRIC] Average days from approval to carrier pickup (warehouse pick-pack-dispatch).
	measure 'Avg Prep Days' =
			CALCULATE(
			    AVERAGEX(
			        FILTER(FCT_ORDERS,
			            FCT_ORDERS[ORDER_STATUS] = "delivered"
			            && NOT ISBLANK(FCT_ORDERS[FULFILLMENT_DAYS])
			            && NOT ISBLANK(FCT_ORDERS[SHIPPING_TRANSIT_DAYS])
			        ),
			        FCT_ORDERS[FULFILLMENT_DAYS] - FCT_ORDERS[SHIPPING_TRANSIT_DAYS]
			    )
			)
		formatString: 0.0
		displayFolder: 04_Funnel
		lineageTag: 02a5d71a-c435-445a-82e3-8fb1d6df79d8

	/// [METRIC] Average credit card installments per order.
	measure 'Avg Credit Card Installments' = CALCULATE(AVERAGE(FCT_ORDER_PAYMENTS[PAYMENT_INSTALLMENTS]), FCT_ORDER_PAYMENTS[PAYMENT_TYPE] = "credit_card")
		formatString: 0.0
		displayFolder: 04_Funnel
		lineageTag: f1000011-0001-0001-0001-000000000011

	/// [METRIC] Freight/shipping as a share of total revenue.
	measure 'Freight as % Revenue' = DIVIDE([Total Freight], [Total Revenue])
		formatString: 0.0%
		displayFolder: 04_Funnel
		lineageTag: f1000012-0001-0001-0001-000000000012

	/// [METRIC] Total payment value from FCT_ORDER_PAYMENTS. Use for payment-type breakdowns by method.
	measure 'Payment Revenue' = SUM(FCT_ORDER_PAYMENTS[PAYMENT_VALUE])
		formatString: $#,##0
		displayFolder: 04_Funnel
		lineageTag: f1000013-0001-0001-0001-000000000013

	/// [METRIC] Share of delivered orders that arrived after the promised delivery date.
	measure 'Late Delivery Rate' = 1 - [On-Time Delivery Rate]
		formatString: 0.0%
		displayFolder: 04_Funnel
		lineageTag: f1000014-0001-0001-0001-000000000014

	/// [METRIC] Share of reviewed orders with 1 or 2 star ratings.
	measure 'Low Rating Rate' =
			DIVIDE(
			    CALCULATE([Total Orders], FCT_ORDERS[REVIEW_SCORE] <= 2, NOT ISBLANK(FCT_ORDERS[REVIEW_SCORE])),
			    CALCULATE([Total Orders], NOT ISBLANK(FCT_ORDERS[REVIEW_SCORE]))
			)
		formatString: 0.0%
		displayFolder: 04_Funnel
		lineageTag: f1000015-0001-0001-0001-000000000015

	/// [METRIC] Share of reviewed orders with 4 or 5 star ratings.
	measure 'High Rating Rate' =
			DIVIDE(
			    CALCULATE([Total Orders], FCT_ORDERS[REVIEW_SCORE] >= 4, NOT ISBLANK(FCT_ORDERS[REVIEW_SCORE])),
			    CALCULATE([Total Orders], NOT ISBLANK(FCT_ORDERS[REVIEW_SCORE]))
			)
		formatString: 0.0%
		displayFolder: 04_Funnel
