	/// [HELPER] Formatted 'start - end' label of the active date range. Not a business metric.
	measure 'Start and End Dates' = ```
			
			VAR __MinDate = CALCULATE(MIN(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
			VAR __MaxDate = CALCULATE(MAX(FCT_ORDERS[ORDER_DATE]), ALLSELECTED(DIM_DATES))
			VAR __StartOfWeek = __MaxDate - WEEKDAY(__MaxDate, 2) + 1
			
			VAR __SelectedPeriod = SELECTEDVALUE('CG Custom Periods'[Period], "Custom")
			
			VAR __StartDate =
			    SWITCH(
			        __SelectedPeriod,
			        "Custom", __MinDate,
			        "Current Week", __MaxDate - WEEKDAY(__MaxDate, 2) + 1,
			        "Last Week", __StartOfWeek - 7,
			        "Last 4 Weeks", __StartOfWeek - 28,
			        "MTD",  DATE(YEAR(__MaxDate), MONTH(__MaxDate), 1),
			        "Last Month", DATE(YEAR(EDATE(__MaxDate, -1)), MONTH(EDATE(__MaxDate, -1)), 1),
			        "QTD", DATE(YEAR(__MaxDate), (QUARTER(__MaxDate) - 1) * 3 + 1, 1),
			        "Last Quarter", DATE(YEAR(__MaxDate), (QUARTER(__MaxDate) - 2) * 3 + 1, 1),
			        "Last 6 Months", EOMONTH(__MaxDate, -6) + 1,
			        "Last 12 Months", EOMONTH(__MaxDate, -12) + 1,
			        "YTD",  DATE(YEAR(__MaxDate), 1, 1),
			        "Last Year", DATE(YEAR(__MaxDate) - 1, 1, 1),
			        "All Time", __MinDate
			    )
			
			VAR __EndDate =
			    SWITCH(
			        __SelectedPeriod,
			        "Custom", __MaxDate,
			        "Current Week", __MaxDate,
			        "Last Week", __StartOfWeek - 1,
			        "Last 4 Weeks", __StartOfWeek - 1,
			        "MTD", __MaxDate,
			        "Last Month", EOMONTH(__MaxDate, -1),
			        "QTD", __MaxDate,
			        "Last Quarter", EOMONTH(DATE(YEAR(__MaxDate), (QUARTER(__MaxDate) - 2) * 3 + 1, 1), 2),
			        "Last 6 Months", __MaxDate,
			        "Last 12 Months", __MaxDate,
			        "YTD", __MaxDate,
			        "Last Year", DATE(YEAR(__MaxDate) - 1, 12, 31),
			        "All Time", __MaxDate
			    )
			
			-- Format the raw dates 
			VAR __FormattedStartDate = FORMAT(__StartDate, "MMM dd, yyyy")
			VAR __FormattedEndDate = FORMAT(__EndDate, "MMM dd, yyyy")
			
			RETURN
			    IF(
			        ISBLANK(__StartDate) || ISBLANK(__EndDate),
			        "No Date Range Selected",
			        __FormattedStartDate & " - " & __FormattedEndDate
			    )
			
			```
		formatString: @
		displayFolder: 11_Custom Period
		lineageTag: 9b396797-0bce-44e0-95ec-355c3161eda0

