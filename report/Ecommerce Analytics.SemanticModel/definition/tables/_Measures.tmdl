	/// [METRIC / time-intelligence] Month-over-month % growth of the selected order-items metric.
	measure 'Time Series MoM Growth %' = ```
			
			
			-- Detect which metric is currently selected
			VAR __SelectedMetric = SELECTEDVALUE('CG Order Items Metrics'[Orders Metric], "Revenue")
			
			-- Current Month 
			VAR __CurrentMonth = 
			    SWITCH(
			        __SelectedMetric,
			        "Revenue", [Order Items Total Revenue],
			        "Orders",  [Order Items Total Orders],
			        "AOV",     [Order Items AOV]
			    )
			
			-- 3. Prior Month 
			VAR __PriorMonth = 
			    CALCULATE(
			        SWITCH(
			            __SelectedMetric,
			            "Revenue", [Order Items Total Revenue],
			            "Orders",  [Order Items Total Orders],
			            "AOV",     [Order Items AOV]
			        ),
			        DATEADD(DIM_DATES[DATE], -1, MONTH),
			        KEEPFILTERS(DIM_DATES[YEAR])
			    )
			
			RETURN
			DIVIDE( __CurrentMonth - __PriorMonth, __PriorMonth)
			
			```
		displayFolder: 09_Time Series
		lineageTag: f6f74a08-073a-46d7-96be-110ef21223bf

		formatStringDefinition = "0.0%;-0.0%;0.0%"

