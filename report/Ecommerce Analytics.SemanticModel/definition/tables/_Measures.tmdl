	/// [HELPER] Formatted label for the max of the selected metric. Not a business metric.
	measure 'Max Selected Metric Label' = ```
			
			VAR __SelectedMetric = SELECTEDVALUE('CG Selected Metric'[Metric])
			VAR __MaxYearly =
			    MAXX(
			        ALLSELECTED ( DIM_DATES[MONTH_YEAR] ),
			        __SelectedMetric
			    )
			
			VAR __YearWithMax =
			    MINX(
			        FILTER(
			            ALLSELECTED ( DIM_DATES[MONTH_YEAR] ),
			            CALCULATE ( __SelectedMetric ) = __MaxYearly
			        ),
			        DIM_DATES[MONTH_YEAR]
			    )
			
			RETURN
			SWITCH(
			    __SelectedMetric,
			    "Orders", __YearWithMax & " most Orders at ",
			    "Revenue", __YearWithMax & " highest Revenue at ",
			    "AOV", __YearWithMax & " highest Profit at ",
			    __YearWithMax & " highest Revenue at "
			)
			    
