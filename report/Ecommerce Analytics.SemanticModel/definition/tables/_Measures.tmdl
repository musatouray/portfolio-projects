	/// [HELPER] Renders an SVG 5-star rating of the average review score. Visual only; not a business metric.
	measure 'Star Rating Review' = ```
			
			VAR Rating        = [Average Review Score]
			VAR TotalStars    = 5
			VAR StarWidth     = 100
			
			VAR FullStars     = INT ( Rating )
			VAR Fraction      = Rating - FullStars
			
			-- perceptual boost
			VAR VisualFraction =
			    MIN ( 1, MAX ( 0, Fraction * 0.9 + 0.25 ) )
			
			VAR FractionWidth = VisualFraction * StarWidth
			
			VAR SvgPrefix =
			"data:image/svg+xml;utf8," &
			"<svg xmlns=""http://www.w3.org/2000/svg"" " &
			"viewBox=""0 0 " & (TotalStars * StarWidth) & " 100"" width=""100%"" height=""100%"">" &
			"<defs>" &
			"  <polygon id=""star"" points=""50,5 65,35 98,40 74,64 80,95 50,80 20,95 26,64 2,40 35,35"" />" &
			"  <clipPath id=""clipStar""><use href=""#star"" /></clipPath>" &
			"  <linearGradient id=""grad"" x1=""0%"" y1=""0%"" x2=""100%"" y2=""0%"">" &
			"    <stop offset=""0%"" stop-color=""#FFD700"" />" &
			"    <stop offset=""100%"" stop-color=""#FFA500"" />" &
			"  </linearGradient>" &
			"  <style>" &
			"    .fillAnim { " &
			"       animation: fillGrow 0.4s ease-out forwards; " &
			"       transform-origin: left center; " &
			"    }" &
			"    @keyframes fillGrow { " &
			"       from { opacity: 0; transform: scaleX(0.6); } " &
			"       to   { opacity: 1; transform: scaleX(1); } " &
			"    }" &
			"  </style>" &
			"</defs>"
			
			VAR StarEmptyUse =
			"<use href=""#star"" fill=""#E0E0E0"" stroke=""#999"" stroke-width=""3"" />"
			
			VAR StarFullUse =
			"<use href=""#star"" fill=""url(#grad)"" stroke=""#CC8A00"" stroke-width=""3"" />"
			
			VAR StarFractionGroup =
			    StarEmptyUse &
			    "<rect x=""0"" y=""0"" width=""" & FractionWidth & """ height=""100"" " &
			    "fill=""url(#grad)"" clip-path=""url(#clipStar)"" class=""fillAnim"" />"
			
			VAR StarsSVG =
			CONCATENATEX(
			    GENERATESERIES(1, TotalStars),
			    VAR Pos = [Value]
			    VAR X   = (Pos - 1) * StarWidth
			    RETURN
			        "<g transform=""translate(" & X & ",0)"">" &
			            IF(
			                Pos <= FullStars,
			                StarFullUse,
			                IF(Pos = FullStars + 1 && Fraction > 0, StarFractionGroup, StarEmptyUse)
			            ) &
			        "</g>"
			)
			
			RETURN
			SvgPrefix & StarsSVG & "</svg>"
			
			```
		formatString: @
		displayFolder: 14_Viz Helpers\_SVG
		lineageTag: 8bbc3f9a-7d7f-4c37-89fe-f30745d9ec00
		dataCategory: ImageUrl

		annotation PBI_FormatHint = {"isText":true}

	/// [HELPER] Renders a decorative SVG currency icon. Visual only; not a business metric.
	measure 'Revenue Currency SVG Icon' = ```
			
			VAR Svg =
			"data:image/svg+xml;utf8," &
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 80' width='100%' height='100%'>" &
			"  <defs>" &
			"    <linearGradient id='currGrad' x1='0%' y1='0%' x2='100%' y2='100%'>" &
			"      <stop offset='0%' stop-color='#4DD3FF' />" &
			"      <stop offset='100%' stop-color='#0072FF' />" &
			"    </linearGradient>" &
			"    <radialGradient id='glassFade' cx='50%' cy='50%' r='75%'>" &
			"      <stop offset='0%' stop-color='rgba(255,255,255,0.22)' />" &
			"      <stop offset='100%' stop-color='rgba(255,255,255,0.05)' />" &
			"    </radialGradient>" &
			"    <style>" &
			"      .glass { " &
			"         fill: url(#glassFade); " &
			"         backdrop-filter: blur(6px); " &
			"      }" &
			"      .symbol { " &
			"         fill: url(#currGrad); " &
			"         font-weight: 600; " &
			"         paint-order: stroke; " &
			"         stroke: rgba(255,255,255,0.35); " &   /* crisp inner glow */
			"         stroke-width: 1.2; " &
			"         animation: popIn 0.45s ease-out forwards; " &
			"         transform-origin: 50% 50%; " &
			"      }" &
			"      @keyframes popIn { " &
			"         0%   { opacity: 0; transform: scale(0.6); } " &
			"         60%  { opacity: 1; transform: scale(1.08); } " &
			"         100% { opacity: 1; transform: scale(1.0); } " &
			"      }" &
			"    </style>" &
			"  </defs>" &
			"  <rect x='0' y='0' width='80' height='80' rx='18' class='glass' />" &
			"  <text x='40' y='42' text-anchor='middle' dominant-baseline='central' " &
			"        font-family='Segoe UI, Roboto, sans-serif' font-size='34' class='symbol'>$</text>" &
			"</svg>"
			
			RETURN Svg
			
			
			```
		formatString: @
		displayFolder: 14_Viz Helpers\_SVG
		lineageTag: 9a13297a-89e6-438e-817e-74a1b7bc279e
		dataCategory: ImageUrl

		annotation PBI_FormatHint = {"isText":true}

