	measure 'Report Style Sheet' = ```
			
			"
			<style>
			    .pbi-container { font-family: 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif; font-size: 14px; color: #333333; line-height: 1.6; max-width: 1000px; margin: 0 auto; padding: 10px; }
			    .pbi-header { background: linear-gradient(90deg, #0078D4, #004578); color: #FFFFFF; padding: 20px; border-radius: 8px 8px 0 0; margin-bottom: 25px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
			    .pbi-header h1 { margin: 0; font-size: 24px; font-weight: 600; letter-spacing: 0.5px; }
			    .pbi-header p { margin: 5px 0 0 0; font-size: 13px; color: #E1F5FE; opacity: 0.9; }
			    .pbi-section-title { color: #004578; font-size: 18px; font-weight: 600; margin-top: 25px; margin-bottom: 15px; border-bottom: 2px solid #E1F5FE; padding-bottom: 6px; }
			    .pbi-sub-title { color: #004578; font-size: 16px; font-weight: 600; margin-top: 25px; margin-bottom: 10px; }
			    .pbi-table { width: 100%; border-collapse: collapse; margin: 15px 0 25px 0; font-size: 14px; box-shadow: 0 2px 3px rgba(0,0,0,0.05); border-radius: 4px; overflow: hidden; }
