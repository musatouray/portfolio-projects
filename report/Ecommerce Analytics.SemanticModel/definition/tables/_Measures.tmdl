	/// [HELPER] Renders an SVG sparkline of monthly orders. Visual only; not a business metric.
	measure 'Orders Sparkline SVG' = ```
			
			-- Step 1: Define SVG canvas boundaries
			VAR __CanvasWidth = 150
			VAR __CanvasHeight = 40
			VAR __Padding = 2
			
			-- Step 2: Grab only the months that actually contain order data
			VAR __FilteredMonths = 
			    FILTER(
			        SUMMARIZE(
			            ALLSELECTED('DIM_DATES'),
			            'DIM_DATES'[YEAR_MONTH]
			        ),
			        NOT(ISBLANK([Total Orders])) -- Excludes empty calendar months
			    )
			
			-- Step 3: Use RANKX on the filtered table to generate safe continuous X indexes
			VAR __SparklineTable = 
			    ADDCOLUMNS(
			        __FilteredMonths,
			        "Y_Value", [Total Orders],
			        "X_Value", RANKX(__FilteredMonths, 'DIM_DATES'[YEAR_MONTH], , ASC)
			    )
			
			-- Step 4: Find min/max values for axis scaling
			VAR __MaxYValue = MAXX(__SparklineTable, [Y_Value])
			VAR __MinYValue = MINX(__SparklineTable, [Y_Value])
			VAR __RangeY = IF(__MaxYValue = __MinYValue, 1, __MaxYValue - __MinYValue)
			
			VAR __MaxXValue = MAXX(__SparklineTable, [X_Value])
			VAR __MinXValue = MINX(__SparklineTable, [X_Value])
			VAR __RangeX = IF(__MaxXValue = __MinXValue, 1, __MaxXValue - __MinXValue)
			
			-- Step 5: Generate the clean coordinate pairs string
			VAR __PathCoordinates = 
			    CONCATENATEX(
			        __SparklineTable,
			        VAR __ScaledX = __Padding + (( [X_Value] - __MinXValue ) / __RangeX) * (__CanvasWidth - (2 * __Padding))
			        VAR __ScaledY = (__CanvasHeight - __Padding) - ((([Y_Value] - __MinYValue) / __RangeY) * (__CanvasHeight - (2 * __Padding)))
			        RETURN __ScaledX & "," & __ScaledY,
			        " ",
			        'DIM_DATES'[YEAR_MONTH],
			        ASC
			    )
			
			-- Step 6: Wrap the coordinate string into standard SVG format
			-- Replaced raw spaces/brackets with URL-safe variants to comply with core engine requirements
			VAR __Raw_SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & __CanvasWidth & " " & __CanvasHeight & "' width='100%' height='100%'>" &
			        "<path d='M " & __Padding & "," & __CanvasHeight & " L " & __PathCoordinates & " L " & __CanvasWidth - __Padding & "," & __CanvasHeight & " Z' fill='rgba(0, 92, 181, 0.1)' />" &
			        "<path d='M " & __PathCoordinates & "' fill='none' stroke='#005CB5' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' />" &
			    "</svg>"
			
			-- Step 7: URL Encode the raw string
			VAR __Encoded_SVG = 
			    SUBSTITUTE(
			        SUBSTITUTE(
			            SUBSTITUTE(
			                SUBSTITUTE(
			                    SUBSTITUTE(
			                        __Raw_SVG,
			                        "#", "%23"
			                    ),
			                    " ", "%20"
			                ),
			                "'", "%27"
			            ),
			            "<", "%3C"
			        ),
			        ">", "%3E"
			    )
			
			VAR __Final_URL = "data:image/svg+xml;utf8," & __Encoded_SVG
			
			RETURN 
			    IF(
			        NOT(ISBLANK([Total Orders])), 
			        __Final_URL, 
			        BLANK()
			    )
			
			```
		formatString: @
		displayFolder: 14_Viz Helpers
		lineageTag: 10531c98-dbc0-4365-92b4-0004fc609f10
		dataCategory: ImageUrl

