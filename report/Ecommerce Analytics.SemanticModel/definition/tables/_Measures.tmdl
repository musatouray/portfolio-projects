			        __SelectedYears = __AllYears, __StartAndEndYear,
			        CONCATENATEX(
			            VALUES(DIM_DATES[YEAR]),
			            DIM_DATES[YEAR],
			            ", "
			        )
			    )
			RETURN
			" " & __SelectedYearsText
