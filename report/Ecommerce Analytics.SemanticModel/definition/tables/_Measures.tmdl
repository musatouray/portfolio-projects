	/// [HELPER] Dynamic sentence summarizing how many top categories make the threshold. Presentation only; the underlying metrics are the Pareto revenue measures.
	measure 'Pareto Title' = ```
			
			VAR __Threshold = [Param: Pareto Threshold Value]
			VAR __AllRevenue = CALCULATE([Order Items Total Revenue], ALLSELECTED(DIM_PRODUCTS))
			
			-- 1. Snapshot each category's revenue
			VAR __CategoryTable = 
			    ADDCOLUMNS(
			        ALLSELECTED(DIM_PRODUCTS[PRODUCT_CATEGORY]), 
			        "@CategoryRevenue", [Order Items Total Revenue]
			    )
			
			-- 2. Build the running total array
			VAR __TableWithRunningTotal = 
			    ADDCOLUMNS(
			        __CategoryTable,
			        "@RunningPct",
			        DIVIDE(
			            SUMX(
			                WINDOW(
			                    1, ABS, 0, REL,
			                    __CategoryTable,
			                    ORDERBY([@CategoryRevenue], DESC)
			                ),
			                [@CategoryRevenue]
			            ),
			            __AllRevenue,
			            0
			        )
			    )
			
			-- 3. Strictly count only rows whose cumulative sum is below or equal to the threshold
			VAR __BestSellingCategories = 
			    FILTER(
			        __TableWithRunningTotal,
			        [@RunningPct] <= __Threshold
			    )
			
			-- 4. Calculate total count and total absolute revenue for the true best-sellers
			VAR __CategoryCount = COUNTROWS(__BestSellingCategories)
			VAR __BestSellingRevenue = SUMX(__BestSellingCategories, [@CategoryRevenue])
			
			-- 5. Format the revenue number into dynamic millions ($XX.XM)
			VAR __FormattedRevenue = 
			    "$" & FORMAT(DIVIDE(__BestSellingRevenue, 1000000), "0.0") & "M"
			
			-- 6. Combine everything into your exact layout
			RETURN
			    "Top " & __CategoryCount & " categories generate " & __FormattedRevenue & ", which is " & FORMAT(__Threshold, "0%") & " of the revenue"
			
			
			
			```
		formatString: @
		displayFolder: 03_Product
		lineageTag: cae551be-770d-49bf-8a6f-66029327ea68

		annotation PBI_FormatHint = {"isText":true}

