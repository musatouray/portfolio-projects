		lineageTag: 33afbc92-c33b-4eea-94a9-c68ff175549e

	/// [METRIC] Cumulative customer revenue at the selected snapshot month (for period-scoped RFM views).
	measure 'RFM Snapshot Month Revenue' = ```
			
			// VAR __SelectedMonth = MAX(DIM_DATES[MONTH_START_DATE])                                   
			// VAR __MonthEnd = EOMONTH(__SelectedMonth, 0)                                                                                       
			// VAR __CustomersInSegment =                                                                                                         
			//     CALCULATETABLE(                                                                                                                
			//         VALUES(FCT_RFM_SEGMENTS[CUSTOMER_KEY]),                                                                                    
			//         FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __SelectedMonth                                                                         
			//     )                                                                                                                              
			// RETURN                                                                                                                             
			// IF(                                                                                                                                
			//     NOT ISBLANK(__SelectedMonth),                                                                                                  
			//     CALCULATE(                                                                                                                     
			//         SUM(FCT_ORDERS[TOTAL_PAYMENT_VALUE]),                                                                                      
			//         FCT_ORDERS[ORDER_DATE] >= __SelectedMonth,                                                                                 
			//         FCT_ORDERS[ORDER_DATE] <= __MonthEnd,                                                                                      
			//         TREATAS(__CustomersInSegment, FCT_ORDERS[CUSTOMER_KEY])                                                                    
			//     )                                                                                                                              
			// )    
			
			
			 
			-- 1. Grab all unique month start dates currently active in the report's filter context
			VAR __SelectedMonths = VALUES(DIM_DATES[MONTH_START_DATE]) 
			RETURN 
			    IF( 
			        NOT(ISBLANK(COUNTROWS(__SelectedMonths))), 
			        -- 2. Iterate through each month one by one and sum the results
			        SUMX(
			            __SelectedMonths,
			            VAR __CurrentMonth = [MONTH_START_DATE]
			            VAR __MonthEnd = EOMONTH(__CurrentMonth, 0)
			            
			            -- 3. Find the customers who belonged to the segment IN THIS SPECIFIC MONTH
			            VAR __CustomersInSegment = 
			                CALCULATETABLE( 
			                    VALUES(FCT_RFM_SEGMENTS[CUSTOMER_KEY]), 
			                    FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __CurrentMonth,
			                    REMOVEFILTERS(DIM_DATES) -- Clear the page-level date filter just for the segment lookup
			                ) 
			            RETURN 
			                -- 4. Calculate orders for those customers inside this specific month's date boundaries
			                CALCULATE( 
			                    SUM(FCT_ORDERS[TOTAL_PAYMENT_VALUE]), 
			                    FCT_ORDERS[ORDER_DATE] >= __CurrentMonth, 
			                    FCT_ORDERS[ORDER_DATE] <= __MonthEnd, 
			                    TREATAS(__CustomersInSegment, FCT_ORDERS[CUSTOMER_KEY]),
			                    REMOVEFILTERS(DIM_DATES) -- Clear the page-level date filter to allow the custom boundaries to work
			                ) 
			        )
			    )
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 01_Segments\RFM
		lineageTag: d72446b8-8ed8-468b-849a-d0e67339498a

	/// [METRIC] Customers who moved from the From-segment (prior snapshot) to the To-segment (current snapshot); the size of each RFM segment migration. Needs From Segment and To Segment on the visual.
	measure 'Transition Count' = ```
			
			VAR ToMonth =
			    MAXX ( ALLSELECTED ( FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] ), FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] )
			VAR FromMonth = EDATE ( ToMonth, -1 )
			VAR FromSeg = SELECTEDVALUE ( 'From Segment'[From Segment] )
			VAR ToSeg = SELECTEDVALUE ( 'To Segment'[To Segment] )
			VAR FromCustomers =
			    CALCULATETABLE (
			        VALUES ( FCT_RFM_SEGMENTS[CUSTOMER_KEY] ),
			        REMOVEFILTERS ( FCT_RFM_SEGMENTS ),
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = FromMonth,
			        FCT_RFM_SEGMENTS[RFM_SEGMENT] = FromSeg
			    )
			VAR ToCustomers =
			    CALCULATETABLE (
			        VALUES ( FCT_RFM_SEGMENTS[CUSTOMER_KEY] ),
			        REMOVEFILTERS ( FCT_RFM_SEGMENTS ),
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = ToMonth,
			        FCT_RFM_SEGMENTS[RFM_SEGMENT] = ToSeg
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( FromSeg ) && NOT ISBLANK ( ToSeg ),
			        COUNTROWS ( INTERSECT ( FromCustomers, ToCustomers ) )
			    )
			
			```
		formatString: #,##0
		displayFolder: 01_Segments\RFM\Transitions
		lineageTag: rt100001-0001-0001-0001-000000000001

	/// [METRIC] Share of the source segment's customers that migrated to the target segment between the two snapshots.
	measure 'Transition % of Source' = ```
			
			VAR ToMonth =
			    MAXX ( ALLSELECTED ( FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] ), FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] )
			VAR FromMonth = EDATE ( ToMonth, -1 )
			VAR FromSeg = SELECTEDVALUE ( 'From Segment'[From Segment] )
			VAR SourceSize =
			    CALCULATE (
			        DISTINCTCOUNT ( FCT_RFM_SEGMENTS[CUSTOMER_KEY] ),
			        REMOVEFILTERS ( FCT_RFM_SEGMENTS ),
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = FromMonth,
			        FCT_RFM_SEGMENTS[RFM_SEGMENT] = FromSeg
			    )
			RETURN
			    DIVIDE ( [Transition Count], SourceSize )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01_Segments\RFM\Transitions
		lineageTag: rt100002-0001-0001-0001-000000000002

	/// [HELPER] Dynamic subtitle naming the two snapshot months compared in the migration visuals. Not a business metric.
	measure 'Transition Window Label' = ```
			
			VAR ToMonth =
			    MAXX ( ALLSELECTED ( FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] ), FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] )
			VAR FromMonth = EDATE ( ToMonth, -1 )
			RETURN
			    "Segment migration:  " & FORMAT ( FromMonth, "MMM yyyy" ) & "   " & UNICHAR ( 8594 ) & "   " & FORMAT ( ToMonth, "MMM yyyy" )
			
			```
		formatString: @
		displayFolder: 01_Segments\RFM\Transitions
		lineageTag: rt100003-0001-0001-0001-000000000003

	/// [METRIC] Share of total lifetime revenue contributed by low_value customers.
	measure 'Low Value CLV Revenue %' = ```
			
			VAR __HistoricalCLV = [Total Historical CLV]
			VAR __LowValue = 
			    CALCULATE(
			        SUM(FCT_CLV_CUSTOMER[TOTAL_LIFETIME_REVENUE]), 
			        FCT_CLV_CUSTOMER[CUSTOMER_VALUE_SEGMENT] = "low_value"
			    )
			
			RETURN
			DIVIDE(
				__LowValue,
			    __HistoricalCLV
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01_Segments\CLV
		lineageTag: 5397585f-eb39-40ec-8578-bf754b59ba13

	measure 'RFM Customer Migration Count' = ```
			
			-- 1. Identify the first and last months of the selected time frame (e.g., YTD or Last 6 Months)
			VAR __MonthsInPeriod = VALUES(DIM_DATES[MONTH_START_DATE])
			VAR __StartMonth = MINX(__MonthsInPeriod, [MONTH_START_DATE])
			VAR __EndMonth = MAXX(__MonthsInPeriod, [MONTH_START_DATE])
			
			-- 2. Capture the segment selected from our new disconnected table (Matrix Rows)
			VAR __SelectedStartSegment = SELECTEDVALUE('From Segment'[From Segment])
			
			-- 3. Capture the segment selected from the main RFM table (Matrix Columns)
			VAR __SelectedEndSegment = SELECTEDVALUE(FCT_RFM_SEGMENTS[RFM_SEGMENT])
			
			-- 4. Get the list of Customer Keys who were in the Starting Segment at the Start Month
			VAR __CustomersAtStart = 
			    CALCULATETABLE(
			        VALUES(FCT_RFM_SEGMENTS[CUSTOMER_KEY]),
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __StartMonth,
			        FCT_RFM_SEGMENTS[RFM_SEGMENT] = __SelectedStartSegment,
			        REMOVEFILTERS(DIM_DATES),
			        REMOVEFILTERS(FCT_RFM_SEGMENTS)
			    )
			
			-- 5. Out of those starting customers, count how many are in the Ending Segment at the End Month
			VAR __MigratedCustomersCount = 
			    CALCULATE(
			        COUNTROWS(FCT_RFM_SEGMENTS),
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __EndMonth,
			        FCT_RFM_SEGMENTS[RFM_SEGMENT] = __SelectedEndSegment,
			        TREATAS(__CustomersAtStart, FCT_RFM_SEGMENTS[CUSTOMER_KEY]),
			        REMOVEFILTERS(DIM_DATES),
			        REMOVEFILTERS('From Segment')
			    )
			
			RETURN
			    -- Safety check: only return data if both row and column segment context exist
			    IF(
			        NOT(ISBLANK(__SelectedStartSegment)) && NOT(ISBLANK(__SelectedEndSegment)),
			        __MigratedCustomersCount
			    )
			
			```
		formatString: 0
		displayFolder: 01_Segments\RFM\Transitions
		lineageTag: eb2ac869-a781-4a1c-8190-cf5be9eed38b

	measure 'Avg Reorder Rate' = ```
			
			VAR __LatestSnapshotMonth = MAX(DIM_DATES[MONTH_START_DATE]) 
			RETURN 
			    IF(
			        NOT(ISBLANK(__LatestSnapshotMonth)),
			        CALCULATE(
			            -- Divide the number of multi-order customers by the total customer count
			            DIVIDE(
			                CALCULATE(COUNTROWS(FCT_RFM_SEGMENTS), FCT_RFM_SEGMENTS[TOTAL_ORDERS] > 1),
			                COUNTROWS(FCT_RFM_SEGMENTS)
			            ),
			            FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshotMonth,
			            REMOVEFILTERS(DIM_DATES)
			        )
			    )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01_Segments\RFM
		lineageTag: 256fe2de-b108-4271-8bf6-da85ca246e36

	/// [METRIC] Customers with CHURN_STATUS = 'Active' at the latest snapshot month (purchased recently, low churn risk).
	measure 'Active Customers' =
			
			VAR __LatestSnapshot = MAX(DIM_DATES[MONTH_START_DATE])
			RETURN
			IF(
			    NOT ISBLANK(__LatestSnapshot),
			    CALCULATE(
			        COUNTROWS(FCT_RFM_SEGMENTS),
			        FCT_RFM_SEGMENTS[CHURN_STATUS] = "Active",
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshot,
			        REMOVEFILTERS(DIM_DATES)
			    )
			)
		displayFolder: 01_Segments\Churn
		lineageTag: c904ed44-6e9e-4c6b-b67f-38d852aba87d

		formatStringDefinition =
				VAR __ActiveCustomers = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __ActiveCustomers <= 1E3, "#,0;-#,0;0",
				        __ActiveCustomers <= 1E4, "#,0,K;-#,0,K;0",
				        __ActiveCustomers <= 1E5, "#,0,K;-#,0,K;0",
				        __ActiveCustomers <= 1E6, "#,0,K;-#,0,K;0",
				        __ActiveCustomers <= 1E7, "#,0,,M;-#,0,,M;0",
				        __ActiveCustomers <= 1E8, "#,0,,M;-#,0,,M;0",
				        __ActiveCustomers <= 1E9, "#,0,,M;-#,0,,M;0"
				    )

	/// [METRIC] Customers with CHURN_STATUS = 'Cooling' at the latest snapshot month (purchase frequency declining, early warning).
	measure 'Cooling Customers' =
			
			VAR __LatestSnapshot = MAX(DIM_DATES[MONTH_START_DATE])
			RETURN
			IF(
			    NOT ISBLANK(__LatestSnapshot),
			    CALCULATE(
			        COUNTROWS(FCT_RFM_SEGMENTS),
			        FCT_RFM_SEGMENTS[CHURN_STATUS] = "Cooling",
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshot,
			        REMOVEFILTERS(DIM_DATES)
			    )
			)
		displayFolder: 01_Segments\Churn
		lineageTag: 1ededa84-b6c1-44a9-a3cb-49bb409466e3

		formatStringDefinition =
				VAR __CoolingCustomers = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __CoolingCustomers <= 1E3, "#,0;-#,0;0",
				        __CoolingCustomers <= 1E4, "#,0,K;-#,0,K;0",
				        __CoolingCustomers <= 1E5, "#,0,K;-#,0,K;0",
				        __CoolingCustomers <= 1E6, "#,0,K;-#,0,K;0",
				        __CoolingCustomers <= 1E7, "#,0,,M;-#,0,,M;0",
				        __CoolingCustomers <= 1E8, "#,0,,M;-#,0,,M;0",
				        __CoolingCustomers <= 1E9, "#,0,,M;-#,0,,M;0"
				    )

	/// [METRIC] Customers with CHURN_STATUS = 'At Risk' at the latest snapshot month (high recency, likely to churn without intervention).
	measure 'At Risk Customers' =
			
			VAR __LatestSnapshot = MAX(DIM_DATES[MONTH_START_DATE])
			RETURN
			IF(
			    NOT ISBLANK(__LatestSnapshot),
			    CALCULATE(
			        COUNTROWS(FCT_RFM_SEGMENTS),
			        FCT_RFM_SEGMENTS[CHURN_STATUS] = "At Risk",
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshot,
			        REMOVEFILTERS(DIM_DATES)
			    )
			)
		displayFolder: 01_Segments\Churn
		lineageTag: 49339485-f886-44d2-92f6-9d62a12592bf

		formatStringDefinition =
				VAR __AtRiskCustomers = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __AtRiskCustomers <= 1E3, "#,0;-#,0;0",
				        __AtRiskCustomers <= 1E4, "#,0,K;-#,0,K;0",
				        __AtRiskCustomers <= 1E5, "#,0,K;-#,0,K;0",
				        __AtRiskCustomers <= 1E6, "#,0,K;-#,0,K;0",
				        __AtRiskCustomers <= 1E7, "#,0,,M;-#,0,,M;0",
				        __AtRiskCustomers <= 1E8, "#,0,,M;-#,0,,M;0",
				        __AtRiskCustomers <= 1E9, "#,0,,M;-#,0,,M;0"
				    )

	/// [METRIC] Share of customers with CHURN_STATUS = 'Churned' at the latest snapshot, in filter context. Used for Churn Status Color conditional formatting.
	measure 'Churn Rate' =
			VAR __LatestSnapshot = MAX(DIM_DATES[MONTH_START_DATE])
			RETURN
			IF(
			    NOT ISBLANK(__LatestSnapshot),
			    DIVIDE(
			        CALCULATE(
			            COUNTROWS(FCT_RFM_SEGMENTS),
			            FCT_RFM_SEGMENTS[CHURN_STATUS] = "Churned",
			            FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshot,
			            REMOVEFILTERS(DIM_DATES)
			        ),
			        CALCULATE(
			            COUNTROWS(FCT_RFM_SEGMENTS),
			            FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshot,
			            REMOVEFILTERS(DIM_DATES)
			        )
			    )
			)
		formatString: 0.0%
		displayFolder: 01_Segments\Churn
		lineageTag: f8b6c884-7d7b-4027-bd05-5891c3faadf6

	/// [METRIC] Predicted 12-month CLV of customers currently in 'Cooling' or 'At Risk' churn status. Quantifies the revenue exposure from customers approaching churn.
	measure 'Revenue At Risk' =
			
			VAR __LatestSnapshot = MAX(DIM_DATES[MONTH_START_DATE])
			VAR __AtRiskKeys =
			    CALCULATETABLE(
			        VALUES(FCT_RFM_SEGMENTS[CUSTOMER_KEY]),
			        FCT_RFM_SEGMENTS[CHURN_STATUS] IN { "Cooling", "At Risk" },
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshot,
			        REMOVEFILTERS(DIM_DATES)
			    )
			RETURN
			IF(
			    NOT ISBLANK(__LatestSnapshot) && COUNTROWS(__AtRiskKeys) > 0,
			    CALCULATE(
			        SUM(FCT_CLV_CUSTOMER[PREDICTED_CLV_12M]),
			        TREATAS(__AtRiskKeys, DIM_CUSTOMERS[CUSTOMER_KEY])
			    )
			)
		displayFolder: 01_Segments\Churn
		lineageTag: d2db208e-77bb-477a-9b22-1cb78ea1dcc9

		formatStringDefinition =
				VAR __FormattedAtRiskRevenue = SELECTEDMEASURE()
				RETURN
				    SWITCH (
				        TRUE (),
				        __FormattedAtRiskRevenue <= 1E3, "$#,0.;-#,0.;0",
				        __FormattedAtRiskRevenue <= 1E4, "$#,0,.00K;-#,0,.00K;0",
				        __FormattedAtRiskRevenue <= 1E5, "$#,0,.0K;-#,0,.0K;0",
				        __FormattedAtRiskRevenue <= 1E6, "$#,0,.K;-#,0,.K;0",
				        __FormattedAtRiskRevenue <= 1E7, "$#,0,,.00M;-#,0,,.00M;0",
				        __FormattedAtRiskRevenue <= 1E8, "$#,0,,.0M;-#,0,,.0M;0",
				        __FormattedAtRiskRevenue <= 1E9, "$#,0,,.M;-#,0,,.M;0"
				    )

	/// [METRIC] Average composite churn risk score (0-100) across customers at the latest snapshot month. Higher = more at risk. Use in filter context to compare scores by segment.
	measure 'Avg Churn Risk Score' =
			VAR __LatestSnapshot = MAX(DIM_DATES[MONTH_START_DATE])
			RETURN
			IF(
			    NOT ISBLANK(__LatestSnapshot),
			    CALCULATE(
			        AVERAGE(FCT_RFM_SEGMENTS[CHURN_RISK_SCORE]),
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshot,
			        REMOVEFILTERS(DIM_DATES)
			    )
			)
		formatString: 0.0
		displayFolder: 01_Segments\Churn
		lineageTag: 3596cef5-39ea-42ff-92a8-c72e29613c67

	/// [METRIC] Count of customers with CHURN_STATUS = 'Churned' at each snapshot month. Designed for time-series trend visuals where DIM_DATES drives the axis (no snapshot locking).
	measure 'Churn Trend Churned' =
			CALCULATE(
			    COUNTROWS(FCT_RFM_SEGMENTS),
			    FCT_RFM_SEGMENTS[CHURN_STATUS] = "Churned"
			)
