	/// [METRIC] Count of customers with CHURN_STATUS = 'At Risk' at each snapshot month. Designed for time-series trend visuals where DIM_DATES drives the axis (no snapshot locking).
	measure 'Churn Trend At Risk' =
			CALCULATE(
			    COUNTROWS(FCT_RFM_SEGMENTS),
			    FCT_RFM_SEGMENTS[CHURN_STATUS] = "At Risk"
