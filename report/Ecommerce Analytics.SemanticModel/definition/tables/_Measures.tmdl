	/// [METRIC] Running total of Total Revenue across the selected date range (respects the DIM_DATES slicer).
	measure 'Cumulative Revenue' =
			CALCULATE(
				[Total Revenue],
				FILTER(
					ALLSELECTED(DIM_DATES[DATE]),
					DIM_DATES[DATE] <= MAX(DIM_DATES[DATE])
				)
			)
