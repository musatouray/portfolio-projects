	/// [METRIC] Gross retained revenue for the cohort-period, capped at initial revenue (excludes expansion; BRL).
	measure 'Cohort Gross Retained Revenue (GRR)' = ```
			
			VAR __CohortSize = [Param: Cohort Size Value] 
			VAR __CohortAsOfDate = [As on Cohort Date] 
			RETURN 
			CALCULATE( 
			    SUM(FCT_COHORT_RETENTION[GROSS_RETAINED_REVENUE]), 
			    KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_MONTH] <= __CohortAsOfDate),
			    KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_SIZE] >= __CohortSize)
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05_Cohort
		lineageTag: c5114899-994f-4244-9ed4-18ddd1e12c6b

	/// [METRIC] Net retained revenue for the cohort-period, including expansion/up-sell (BRL).
	measure 'Cohort Net Retained Revenue (NRR)' = ```
			
			VAR __CohortSize = [Param: Cohort Size Value] 
			VAR __CohortAsOfDate = [As on Cohort Date] 
			RETURN 
			CALCULATE( 
			    SUM(FCT_COHORT_RETENTION[NET_RETAINED_REVENUE]), 
			    KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_MONTH] <= __CohortAsOfDate),
			    KEEPFILTERS(FCT_COHORT_RETENTION[COHORT_SIZE] >= __CohortSize)
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
