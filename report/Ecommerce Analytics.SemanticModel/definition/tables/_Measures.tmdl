	/// [HELPER] SVG legend for the actual vs moving-average series. Not a business metric.
	measure 'Time Series Moving Averages Legend' = ```
			
			VAR __SelectedMetric = SELECTEDVALUE('CG Order Items Metrics'[Orders Metric], "Revenue") 
			VAR __SelectedMovingAvg = SELECTEDVALUE('CG Rolling Averages'[Metric], "3M") 
			
			-- Colors
			VAR __ActualColor = "#1E3A5F" 
			VAR __MAColor = "#A5B0BF" 
			VAR __TextColor = "#607D8B" 
			
			-- Calculate width dynamically 
			VAR __TextLength = LEN(__SelectedMetric & __SelectedMovingAvg) 
			VAR __Width = 200 + (__TextLength * 7) 
			
			-- Calculate dynamic X offset upfront to completely remove the illegal nested RETURN 
			VAR __FirstBlockEnd = 25 + (LEN(__SelectedMetric) * 8) 
			
			
			RETURN 
			    "<svg xmlns=""http://w3.org"" width=""" & __Width & """ height=""30"" viewBox=""0 0 " & __Width & " 30"">" & 
			    
			    -- Actual Metric
			    "<circle cx=""15"" cy=""15"" r=""6"" fill=""" & __ActualColor & """ />" & 
			    "<text x=""28"" y=""20"" font-family=""Segoe UI, Arial"" font-size=""12"" font-weight=""400"" fill=""" & __TextColor & """>" & __SelectedMetric & "</text>" & 
			    
			    -- Moving Average
			    "<circle cx=""" & (__FirstBlockEnd + 15) & """ cy=""15"" r=""6"" fill=""" & __MAColor & """ />" & 
			    "<text x=""" & (__FirstBlockEnd + 28) & """ y=""20"" font-family=""Segoe UI, Arial"" font-size=""12"" font-weight=""400"" fill=""" & __TextColor & """>" & 
			        __SelectedMovingAvg & " Moving Average" & 
			    "</text>" & 
			    
			    "</svg>"
			
			```
