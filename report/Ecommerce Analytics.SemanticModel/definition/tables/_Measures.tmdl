	/// [METRIC] Customer count at the latest snapshot month (point-in-time RFM population). Grain: latest snapshot.
	measure 'RFM Lifetime Customers' = ```
			
			VAR __LatestSnapshot = MAX(DIM_DATES[MONTH_START_DATE])
			
			RETURN
			IF(
			    NOT(ISBLANK(__LatestSnapshot)),
			    CALCULATE(
			        COUNTROWS(FCT_RFM_SEGMENTS),
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshot,
			        REMOVEFILTERS(DIM_DATES)
			    )
			)
			
