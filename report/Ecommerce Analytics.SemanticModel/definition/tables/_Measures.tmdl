	/// [HELPER] Auto-generated narrative paragraph (text) summarizing the period. Presentation only; not a queryable metric.
	measure 'Executive Summary Page' = ```
			
			-- ============================================================================
			-- Period context
			-- ============================================================================
			VAR __SelectedPeriod = SELECTEDVALUE( 'CG Custom Periods'[Period] )
			VAR __Space          = REPT( UNICHAR(160), 2 )
			VAR __LineBreak      = UNICHAR(10)
			
			VAR __StartDate      = MIN( DIM_DATES[DATE] )
			VAR __EndDate        = MAX( DIM_DATES[DATE] )
			
			VAR __PeriodPhrase   =
			    SWITCH(
			        TRUE(),
			        __SelectedPeriod = "Custom",
			            "From " & FORMAT( __StartDate, "mmm d, yyyy" )
			                    & " to " & FORMAT( __EndDate, "mmm d, yyyy" ),
			        ISBLANK( __SelectedPeriod ),
			            "This period",
			        __SelectedPeriod
			    )
			
			-- ============================================================================
			-- Direction glyphs
			-- ============================================================================
			VAR __Up   = UNICHAR(9650)   -- ▲
			VAR __Down = UNICHAR(9660)   -- ▼
			VAR __Flat = UNICHAR(9472)   -- ─
			
			-- ============================================================================
			-- KPI snapshot
			-- ============================================================================
			VAR __Revenue       = [Total Revenue]
			VAR __RevenueShort  = [Revenue Format Large]
			VAR __RevenueYoY    = [Revenue YoY %]
			VAR __RevenueArrow  =
			    SWITCH( TRUE(),
			        __RevenueYoY >  0.01, __Up,
			        __RevenueYoY < -0.01, __Down,
			        __Flat
			    )
			
			--VAR __Orders        = [Total Orders]
			VAR __OrdersYoY     = [Orders YoY %]
			VAR __OrdersArrow   =
			    SWITCH( TRUE(),
			        __OrdersYoY >  0.01, "Orders increased by" &  __Space & __Up & __Space & FORMAT( __OrdersYoY, "0.0%;-0.0%;0%" ) & __Space & "from last year",
			        __OrdersYoY < -0.01, "Orders decreased by" &  __Space & __Down & __Space & FORMAT( __OrdersYoY, "0.0%;-0.0%;0%" ) & __Space & "from last year",
			        "Orders remained flat" &  __Space & __Flat & __Space & FORMAT( __OrdersYoY, "0.0%;-0.0%;0%" ) & __Space & "from last year"
			    )
			
			VAR __AOV           = [Average Order Value]
			VAR __DeliveryRate  = [On-Time Delivery Rate]
			VAR __ReviewScore   = [Average Review Score]
			
			-- ============================================================================
			-- Operational verbs
			-- ============================================================================
			VAR __DeliveryVerb  =
			    SWITCH( TRUE(),
			        __DeliveryRate >= 0.90, "Strong on-time delivery at",
			        __DeliveryRate >= 0.75, "Stable on-time delivery at",
			        "On-time delivery softening to"
			    )
			
			VAR __ReviewVerb    =
			    SWITCH( TRUE(),
			        __ReviewScore >= 4.0, " customer satisfaction is high at",
			        __ReviewScore >= 3.0, " customer satisfaction is mixed at",
			        " customer satisfaction is at risk —"
			    )
			
			-- ============================================================================
			-- RFM revenue contribution
			-- ============================================================================
			VAR __TotalRFMRev   = CALCULATE( [All Segments Revenue], ALL( FCT_RFM_SEGMENTS[RFM_SEGMENT] ) )
			VAR __ChampionsRev  = CALCULATE( [All Segments Revenue], FCT_RFM_SEGMENTS[RFM_SEGMENT] = "Champions" )
			VAR __AtRiskRev     = CALCULATE( [All Segments Revenue], FCT_RFM_SEGMENTS[RFM_SEGMENT] IN { "At Risk", "Hibernating" } )
			VAR __ChampionsPct  = DIVIDE( __ChampionsRev, __TotalRFMRev )
			VAR __AtRiskPct     = DIVIDE( __AtRiskRev,    __TotalRFMRev )
			
			-- ============================================================================
			-- Top & bottom category
			-- ============================================================================
			VAR __TopCatRow       = TOPN( 1, VALUES( DIM_PRODUCTS[PRODUCT_CATEGORY] ), [Running Total Product Revenue], DESC )
			VAR __TopCategory     = MAXX( __TopCatRow, DIM_PRODUCTS[PRODUCT_CATEGORY] )
			VAR __TopCatRevenue   = MAXX( __TopCatRow, [Running Total Product Revenue] )
			VAR __TopCatLabel     =
			    SWITCH( TRUE(),
			        __TopCatRevenue >= 1000000, FORMAT( __TopCatRevenue / 1000000, "$#,##0.0" ) & "M",
			        __TopCatRevenue >=    1000, FORMAT( __TopCatRevenue /    1000, "$#,##0"   ) & "K",
			        FORMAT( __TopCatRevenue, "$#,##0" )
			    )
			
			VAR __BottomCatRow    =
			    TOPN(
			        1,
			        FILTER( VALUES( DIM_PRODUCTS[PRODUCT_CATEGORY] ), NOT ISBLANK( [Running Total Product Revenue] ) ),
			        [Running Total Product Revenue],
			        ASC
			    )
			VAR __BottomCategory  = MAXX( __BottomCatRow, DIM_PRODUCTS[PRODUCT_CATEGORY] )
			
			-- ============================================================================
			-- No-activity fallback message (grammar-aware per branch)
			-- ============================================================================
			VAR __NoActivityMessage =
			    SWITCH(
			        TRUE(),
			        __SelectedPeriod = "Custom",
			            "No activity between " & FORMAT( __StartDate, "mmm d, yyyy" )
			                                   & " and " & FORMAT( __EndDate, "mmm d, yyyy" ),
			        ISBLANK( __SelectedPeriod ),
			            "No activity in this period",
			        "No activity in " & __SelectedPeriod
			    )
			
			-- ============================================================================
			-- Compose narrative
			-- ============================================================================
			VAR __HeadlineLine =
			    __PeriodPhrase & ", the business delivered" & __Space & __RevenueShort &
			    IF(
			        NOT ISBLANK( __RevenueYoY ),
			        __Space & "(" & __RevenueArrow & __Space & FORMAT( __RevenueYoY, "0.0%;-0.0%;0%" ) & __Space & "YoY)",
			        ""
			    ) &
			    ". " & __OrdersArrow & " at an average order value of " & FORMAT( __AOV, "$#,##0" ) & "." & __LineBreak &
			    __DeliveryVerb & __Space & FORMAT( __DeliveryRate, "0.0%" ) & " and " &
			    __ReviewVerb   & __Space & FORMAT( __ReviewScore,  "0.0"  ) & "/5."
			
			VAR __CustomerLine =
			    " Champions drive" & __Space & FORMAT( __ChampionsPct, "0%" ) & __Space & "of revenue" &
			    " and " &
			    FORMAT( __AtRiskPct, "0%" ) & __Space & "concentrated in At Risk & Hibernating customers." &
			    "The worst performing product category is " & __TopCategory & __Space & "(" & __TopCatLabel & ")" &
			    " while " & __BottomCategory & " is the best category." 
			
			RETURN
			    IF(
			        ISBLANK( __Revenue ),
			        __NoActivityMessage,
			        __HeadlineLine & __CustomerLine
			    )
			```
		formatString: @
		displayFolder: 14_Viz Helpers
		lineageTag: fbb66fdd-9204-4a4e-893e-8ffb875bcccc

		annotation PBI_FormatHint = {"isText":true}

	/// [HELPER] Light-theme variant of the HTML landing page. Presentation only; not a business metric.
	measure 'Landing Page Light' = ```
			
			-- =============================================================================
			-- Live KPI values (identical to the dark version) 
			-- =============================================================================
			--VAR __Revenue          = [Total Revenue]
			VAR __RevenueShort     = [Revenue Format Large]
			VAR __RevenueYoY       = [Revenue YoY %]
			
			VAR __Orders           = [Total Orders]
			VAR __OrdersStr        = FORMAT( __Orders, "#,##0" )
			VAR __OrdersYoY        = [Orders YoY %]
			
			VAR __DeliveryRate     = [On-Time Delivery Rate]
			VAR __DeliveryRateStr  = FORMAT( __DeliveryRate, "0.0%" )
			VAR __DeliveryPrior    = [Prior Year On-Time Delivery]
			VAR __DeliveryChange   = __DeliveryRate - __DeliveryPrior
			
			VAR __ReviewScore      = [Average Review Score]
			VAR __ReviewScoreStr   = FORMAT( __ReviewScore, "0.0" )
			VAR __ReviewPrior      = [Prior Year Avg Review Score]
			VAR __ReviewChange     = __ReviewScore - __ReviewPrior
			
			-- =============================================================================
			-- Light-theme indicator palette (Fluent semantic colors)
			-- =============================================================================
			VAR __Green = "#107C41"
			VAR __Red   = "#C42B1C"
			VAR __Grey  = "#605E5C"
			
			VAR __RevColor =
			    SWITCH( TRUE(),
			        __RevenueYoY >  0.005, __Green,
			        __RevenueYoY < -0.005, __Red,
			        __Grey
			    )
			VAR __RevArrow =
			    SWITCH( TRUE(),
			        __RevenueYoY >  0.005, "&uarr;",
			        __RevenueYoY < -0.005, "&darr;",
			        "&rarr;"
			    )
			VAR __RevIndicator =
			    IF( NOT ISBLANK( __RevenueYoY ),
			        "<span style=""font-size:12px;color:" & __RevColor & ";margin-left:10px;font-weight:600;"">"
			            & __RevArrow & " " & FORMAT( ABS( __RevenueYoY ), "0.0%" )
			            & "</span>",
			        ""
			    )
			
			VAR __OrdColor =
			    SWITCH( TRUE(),
			        __OrdersYoY >  0.005, __Green,
			        __OrdersYoY < -0.005, __Red,
			        __Grey
			    )
			VAR __OrdArrow =
			    SWITCH( TRUE(),
			        __OrdersYoY >  0.005, "&uarr;",
			        __OrdersYoY < -0.005, "&darr;",
			        "&rarr;"
			    )
			VAR __OrdIndicator =
			    IF( NOT ISBLANK( __OrdersYoY ),
			        "<span style=""font-size:12px;color:" & __OrdColor & ";margin-left:10px;font-weight:600;"">"
			            & __OrdArrow & " " & FORMAT( ABS( __OrdersYoY ), "0.0%" )
			            & "</span>",
			        "<span style=""font-size:12px;color:" & __Grey & ";margin-left:10px;font-weight:600;"">&rarr;</span>"
			    )
			
			VAR __DelColor =
			    SWITCH( TRUE(),
			        __DeliveryChange >  0.005, __Green,
			        __DeliveryChange < -0.005, __Red,
			        __Grey
			    )
			VAR __DelArrow =
			    SWITCH( TRUE(),
			        __DeliveryChange >  0.005, "&uarr;",
			        __DeliveryChange < -0.005, "&darr;",
			        "&rarr;"
			    )
			VAR __DelIndicator =
			    IF( NOT ISBLANK( __DeliveryChange ),
			        "<span style=""font-size:12px;color:" & __DelColor & ";margin-left:10px;font-weight:600;"">"
			            & __DelArrow & " " & FORMAT( ABS( __DeliveryChange ) * 100, "0.0" ) & "pp"
			            & "</span>",
			        ""
			    )
			
			VAR __RevScColor =
			    SWITCH( TRUE(),
			        __ReviewChange >  0.05, __Green,
			        __ReviewChange < -0.05, __Red,
			        __Grey
			    )
			VAR __RevScArrow =
			    SWITCH( TRUE(),
			        __ReviewChange >  0.05, "&uarr;",
			        __ReviewChange < -0.05, "&darr;",
			        "&rarr;"
			    )
			VAR __RevScIndicator =
			    IF( NOT ISBLANK( __ReviewChange ),
			        "<span style=""font-size:12px;color:" & __RevScColor & ";margin-left:10px;font-weight:600;"">"
			            & __RevScArrow & " " & FORMAT( ABS( __ReviewChange ), "0.0" )
			            & "</span>",
			        ""
			    )
			
			RETURN
			"<div style=""width:1920px;height:1080px;position:relative;overflow:hidden;font-family:'Segoe UI',Inter,sans-serif;background:linear-gradient(180deg,#FFFFFF 0%,#DEE5EE 55%,#B7C5DB 100%);"">
			<canvas id=""ppl1"" style=""position:absolute;inset:0;width:100%;height:100%""></canvas>
			<div style=""position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(0,120,212,0.5),transparent);""></div>
			<div style=""position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(0,120,212,0.3),transparent);""></div>
			<a href=""https://www.linkedin.com/in/musa-touray/"" target=""_blank"" rel=""noopener"" style=""position:absolute;top:96px;right:96px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:#FFFFFF;border:1px solid rgba(0,120,212,0.7);border-radius:10px;z-index:5;cursor:pointer;text-decoration:none;box-shadow:0 4px 14px rgba(0,120,212,0.12);opacity:0;animation:pplFade .7s 2.3s forwards,pplLinkedInPulse 1.6s 3s infinite;"" title=""Connect on LinkedIn""><svg width=""22"" height=""22"" viewBox=""0 0 24 24"" fill=""#0078D4"" aria-hidden=""true""><path d=""M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z""/></svg></a>
			<div style=""position:absolute;inset:0;z-index:2;display:grid;grid-template-columns:1.1fr 1fr;align-items:center;padding:6rem;gap:4rem;"">
			<div>
			<div style=""display:inline-flex;align-items:center;gap:10px;border:1px solid rgba(0,120,212,0.28);border-radius:4px;padding:7px 18px;margin-bottom:28px;opacity:0;animation:pplFade .7s .8s forwards;background:rgba(255,255,255,0.65);""><div style=""width:7px;height:7px;border-radius:50%;background:#0078D4;animation:pplBlink 1.6s infinite;box-shadow:0 0 10px rgba(0,120,212,0.6);""></div><span style=""font-size:11px;letter-spacing:3.5px;text-transform:uppercase;color:#0078D4;font-weight:600;"">E-Commerce Analytics &middot; Performance Pulse</span></div>
			<div style=""font-size:64px;font-weight:300;color:#1A1A1A;line-height:1.08;margin-bottom:20px;opacity:0;animation:pplFade .7s 1.1s forwards;letter-spacing:-1.8px;"">Where <strong style=""font-weight:700;background:linear-gradient(135deg,#0078D4,#003E73);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;"">data</strong><br>tells the story.</div>
			<div style=""width:0;height:1px;background:linear-gradient(90deg,#0078D4,transparent);margin:28px 0;animation:pplExpand .9s 1.5s forwards;""></div>
			<div style=""font-size:18px;color:#605E5C;line-height:1.9;max-width:600px;opacity:0;animation:pplFade .7s 1.7s forwards;font-weight:500;"">A complete ecommerce marketplace analysis &mdash; from order placement to customer segmentation, cohort &amp; churn, funnel, market basket and customer lifetime value. Engineered on dbt + Snowflake + Docker + AWS S3 + Power BI.</div>
			<div style=""display:flex;gap:14px;margin-top:3rem;opacity:0;animation:pplFade .7s 2s forwards;"">
			<div style=""padding:14px 30px;background:linear-gradient(135deg,#0078D4,#106EBE);color:#fff;font-size:13px;font-weight:600;letter-spacing:0.5px;border-radius:6px;cursor:pointer;box-shadow:0 6px 20px rgba(0,120,212,0.3);"">View Dashboard &rarr;</div>
			<div style=""padding:14px 30px;background:#FFFFFF;color:#201F1E;font-size:13px;font-weight:600;letter-spacing:0.5px;border-radius:6px;border:1px solid rgba(0,120,212,0.3);cursor:pointer;box-shadow:0 2px 8px rgba(0,120,212,0.06);"">Visit Repository</div>
			</div></div>
			<div style=""display:flex;flex-direction:column;gap:14px;opacity:0;animation:pplSlide .8s 1.3s forwards;"">
			<div style=""display:grid;grid-template-columns:1fr 1fr;gap:14px;"">
			<!-- 
			<div style=""background:#FFFFFF;border:1px solid rgba(0,120,212,0.18);border-radius:8px;padding:22px 24px;box-shadow:0 4px 16px rgba(0,120,212,0.08);""><div style=""font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:#0078D4;margin-bottom:12px;font-weight:600;"">Total Revenue</div><div style=""font-size:32px;font-weight:600;color:#201F1E;letter-spacing:-0.5px;"">"
			    & __RevenueShort & __RevIndicator &
			"</div></div>
			<div style=""background:#FFFFFF;border:1px solid rgba(0,120,212,0.18);border-radius:8px;padding:22px 24px;box-shadow:0 4px 16px rgba(0,120,212,0.08);""><div style=""font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:#0078D4;margin-bottom:12px;font-weight:600;"">Orders Analyzed</div><div style=""font-size:32px;font-weight:600;color:#201F1E;letter-spacing:-0.5px;"">"
			    & __OrdersStr & __OrdIndicator &
			"</div></div>
			</div>
			<div style=""display:grid;grid-template-columns:1fr 1fr;gap:14px;"">
			<div style=""background:#FFFFFF;border:1px solid rgba(0,120,212,0.18);border-radius:8px;padding:22px 24px;box-shadow:0 4px 16px rgba(0,120,212,0.08);""><div style=""font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:#0078D4;margin-bottom:12px;font-weight:600;"">On-Time Delivery</div><div style=""font-size:32px;font-weight:600;color:#201F1E;letter-spacing:-0.5px;"">"
			    & __DeliveryRateStr & __DelIndicator &
			"</div></div>
			<div style=""background:#FFFFFF;border:1px solid rgba(0,120,212,0.18);border-radius:8px;padding:22px 24px;box-shadow:0 4px 16px rgba(0,120,212,0.08);""><div style=""font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:#0078D4;margin-bottom:12px;font-weight:600;"">Avg Review Score</div><div style=""font-size:32px;font-weight:600;color:#201F1E;letter-spacing:-0.5px;"">"
			    & __ReviewScoreStr & "<span style=""font-size:15px;color:#605E5C;"">/5</span>" & __RevScIndicator &
			"</div></div>
			</div>
			<div style=""background:#FFFFFF;border:1px solid rgba(0,120,212,0.18);border-radius:8px;padding:22px 24px;box-shadow:0 4px 16px rgba(0,120,212,0.08);"">
			<div style=""display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px;""><div style=""font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:#0078D4;font-weight:600;"">Coverage</div><div style=""font-size:11px;color:#605E5C;letter-spacing:0.3px;"">18 Advanced SQL Patterns &middot; 22 dbt Models</div></div>
			<div style=""height:3px;background:rgba(0,120,212,0.1);border-radius:2px;overflow:hidden;""><div style=""height:100%;width:0;border-radius:2px;background:linear-gradient(90deg,#0078D4,#4FA8DF);animation:pplProgress 1.6s 2.2s forwards;box-shadow:0 0 8px rgba(0,120,212,0.35);""></div></div>
			</div></div></div>
			-->
			<style>
			@keyframes pplFade{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
			@keyframes pplSlide{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}
			@keyframes pplExpand{to{width:280px}}
			@keyframes pplBlink{0%,100%{opacity:1;box-shadow:0 0 12px rgba(0,120,212,0.6)}50%{opacity:.3;box-shadow:0 0 4px rgba(0,120,212,0.3)}}
			@keyframes pplProgress{to{width:100%}}
			@keyframes pplLinkedInPulse{0%,100%{border-color:rgba(0,120,212,0.7);box-shadow:0 4px 14px rgba(0,120,212,0.12),0 0 16px rgba(0,120,212,0.45)}50%{border-color:rgba(0,120,212,0.22);box-shadow:0 4px 14px rgba(0,120,212,0.12),0 0 4px rgba(0,120,212,0.08)}}
			</style>
			<script>
			var lc=document.getElementById('ppl1'),lx=lc.getContext('2d'),lw,lh,lt=0,curve=[],dots=[];
			function lpi(){lw=lc.width=lc.parentElement.offsetWidth;lh=lc.height=lc.parentElement.offsetHeight;curve=Array.from({length:96},function(v,i){return{x:lw*(i/95),baseY:lh*0.64+Math.sin(i*0.16)*70+Math.cos(i*0.07)*38};});dots=Array.from({length:24},function(){return{t:Math.random(),v:0.00018+Math.random()*0.00055,r:1.8+Math.random()*2,pulse:Math.random()*Math.PI*2};});}
			function lcY(t,ph){var idx=t*(curve.length-1),i0=Math.floor(idx),i1=Math.min(i0+1,curve.length-1),f=idx-i0;var y0=curve[i0].baseY+Math.sin(i0*0.18+ph*0.018)*12;var y1=curve[i1].baseY+Math.sin(i1*0.18+ph*0.018)*12;return y0+(y1-y0)*f;}
			function lpd(){lx.clearRect(0,0,lw,lh);lt+=0.3;lx.beginPath();curve.forEach(function(p,i){var y=p.baseY-180+Math.sin(i*0.14+lt*0.016)*16;i===0?lx.moveTo(p.x,y):lx.lineTo(p.x,y);});lx.strokeStyle='rgba(0,120,212,0.12)';lx.lineWidth=1;lx.stroke();lx.beginPath();curve.forEach(function(p,i){var y=p.baseY+Math.sin(i*0.18+lt*0.018)*12;i===0?lx.moveTo(p.x,y):lx.lineTo(p.x,y);});lx.strokeStyle='rgba(0,120,212,0.32)';lx.lineWidth=1.2;lx.stroke();dots.forEach(function(d){d.t+=d.v;if(d.t>1)d.t-=1;d.pulse+=0.026;d.x=d.t*lw;d.y=lcY(d.t,lt);});dots.forEach(function(a,i){dots.forEach(function(b,j){if(j<=i)return;var ds=Math.hypot(a.x-b.x,a.y-b.y);if(ds<210){lx.strokeStyle='rgba(0,120,212,'+(0.3*(1-ds/210))+')';lx.lineWidth=0.6;lx.beginPath();lx.moveTo(a.x,a.y);lx.lineTo(b.x,b.y);lx.stroke();}});});dots.forEach(function(d){var a=0.55+Math.sin(d.pulse)*0.3;lx.fillStyle='rgba(0,120,212,'+(a*0.1)+')';lx.beginPath();lx.arc(d.x,d.y,d.r*4.5,0,Math.PI*2);lx.fill();lx.fillStyle='rgba(0,120,212,'+(a*0.25)+')';lx.beginPath();lx.arc(d.x,d.y,d.r*2.4,0,Math.PI*2);lx.fill();lx.fillStyle='rgba(0,120,212,'+(0.9+Math.sin(d.pulse)*0.1)+')';lx.beginPath();lx.arc(d.x,d.y,d.r,0,Math.PI*2);lx.fill();});requestAnimationFrame(lpd);}
			lpi();lpd();window.addEventListener('resize',lpi);
			</script>
			</div>"
			```
		formatString: @
		displayFolder: 15_Landing Page
		lineageTag: f2d7dde3-02e7-48f8-9bcd-a1b401761b0a

