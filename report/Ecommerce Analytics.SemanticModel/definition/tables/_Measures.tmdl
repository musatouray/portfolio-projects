	measure 'Copy Landing Page Light' = ```
			
			-- =============================================================================
			-- Live KPI values (identical to the dark version) 
			-- =============================================================================
			--VAR __Revenue          = [Total Revenue]
			VAR __RevenueShort     = [Revenue Format Large]
			VAR __RevenueYoY       = [Revenue YoY %]
			
			VAR __Orders           = [Total Orders]
			VAR __OrdersStr        = FORMAT( __Orders, "#,##0" )
			VAR __OrdersYoY        = [Orders YoY %]
			
			VAR __DeliveryRate     = [On-Time Delivery Rate]
			VAR __DeliveryRateStr  = FORMAT( __DeliveryRate, "0.0%" )
			VAR __DeliveryPrior    = [Prior Year On-Time Delivery]
			VAR __DeliveryChange   = __DeliveryRate - __DeliveryPrior
			
			VAR __ReviewScore      = [Average Review Score]
			VAR __ReviewScoreStr   = FORMAT( __ReviewScore, "0.0" )
			VAR __ReviewPrior      = [Prior Year Avg Review Score]
			VAR __ReviewChange     = __ReviewScore - __ReviewPrior
			
			-- =============================================================================
			-- Light-theme indicator palette (Fluent semantic colors)
			-- =============================================================================
			VAR __Green = "#107C41"
			VAR __Red   = "#C42B1C"
			VAR __Grey  = "#605E5C"
			
			VAR __RevColor =
			    SWITCH( TRUE(),
			        __RevenueYoY >  0.005, __Green,
			        __RevenueYoY < -0.005, __Red,
			        __Grey
			    )
			VAR __RevArrow =
			    SWITCH( TRUE(),
			        __RevenueYoY >  0.005, "&uarr;",
			        __RevenueYoY < -0.005, "&darr;",
			        "&rarr;"
			    )
			VAR __RevIndicator =
			    IF( NOT ISBLANK( __RevenueYoY ),
			        "<span style=""font-size:12px;color:" & __RevColor & ";margin-left:10px;font-weight:600;"">"
			            & __RevArrow & " " & FORMAT( ABS( __RevenueYoY ), "0.0%" )
			            & "</span>",
			        ""
			    )
			
			VAR __OrdColor =
			    SWITCH( TRUE(),
			        __OrdersYoY >  0.005, __Green,
			        __OrdersYoY < -0.005, __Red,
			        __Grey
			    )
			VAR __OrdArrow =
			    SWITCH( TRUE(),
			        __OrdersYoY >  0.005, "&uarr;",
			        __OrdersYoY < -0.005, "&darr;",
			        "&rarr;"
			    )
			VAR __OrdIndicator =
			    IF( NOT ISBLANK( __OrdersYoY ),
			        "<span style=""font-size:12px;color:" & __OrdColor & ";margin-left:10px;font-weight:600;"">"
			            & __OrdArrow & " " & FORMAT( ABS( __OrdersYoY ), "0.0%" )
			            & "</span>",
			        "<span style=""font-size:12px;color:" & __Grey & ";margin-left:10px;font-weight:600;"">&rarr;</span>"
			    )
			
			VAR __DelColor =
			    SWITCH( TRUE(),
			        __DeliveryChange >  0.005, __Green,
			        __DeliveryChange < -0.005, __Red,
			        __Grey
			    )
			VAR __DelArrow =
			    SWITCH( TRUE(),
			        __DeliveryChange >  0.005, "&uarr;",
			        __DeliveryChange < -0.005, "&darr;",
			        "&rarr;"
			    )
			VAR __DelIndicator =
			    IF( NOT ISBLANK( __DeliveryChange ),
			        "<span style=""font-size:12px;color:" & __DelColor & ";margin-left:10px;font-weight:600;"">"
			            & __DelArrow & " " & FORMAT( ABS( __DeliveryChange ) * 100, "0.0" ) & "pp"
			            & "</span>",
			        ""
			    )
			
			VAR __RevScColor =
			    SWITCH( TRUE(),
			        __ReviewChange >  0.05, __Green,
			        __ReviewChange < -0.05, __Red,
			        __Grey
			    )
			VAR __RevScArrow =
			    SWITCH( TRUE(),
			        __ReviewChange >  0.05, "&uarr;",
			        __ReviewChange < -0.05, "&darr;",
			        "&rarr;"
			    )
			VAR __RevScIndicator =
			    IF( NOT ISBLANK( __ReviewChange ),
			        "<span style=""font-size:12px;color:" & __RevScColor & ";margin-left:10px;font-weight:600;"">"
			            & __RevScArrow & " " & FORMAT( ABS( __ReviewChange ), "0.0" )
			            & "</span>",
			        ""
			    )
			
