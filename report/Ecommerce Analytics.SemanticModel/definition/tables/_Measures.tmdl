	/// [METRIC] Customers with CHURN_STATUS = 'Churned' at the latest (or slicer-selected) snapshot month. Grain: latest snapshot.
	measure 'Churned Customers' =
			
			VAR __LatestSnapshot = MAX(DIM_DATES[MONTH_START_DATE])
			RETURN
			IF(
			    NOT ISBLANK(__LatestSnapshot),
			    CALCULATE(
			        COUNTROWS(FCT_RFM_SEGMENTS),
			        FCT_RFM_SEGMENTS[CHURN_STATUS] = "Churned",
			        FCT_RFM_SEGMENTS[SNAPSHOT_MONTH] = __LatestSnapshot,
			        REMOVEFILTERS(DIM_DATES)
			    )
			)
		displayFolder: 01_Segments\Churn
		lineageTag: ch100010-0001-0001-0001-000000000010

