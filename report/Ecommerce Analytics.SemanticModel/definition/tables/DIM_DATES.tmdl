	column YEAR
		dataType: int64
		formatString: 0
		lineageTag: 75ec83fb-7478-46a4-8688-b75081936d6b
		summarizeBy: none
		sourceColumn: YEAR

		annotation SummarizationSetBy = User

	/// Year-quarter label (e.g., 2023-Q4) for quarterly grouping.
	column YEAR_QUARTER
		dataType: string
		lineageTag: b34ebc78-d606-461d-a72b-faedb2de3030
		summarizeBy: none
		sourceColumn: YEAR_QUARTER

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	/// First day of the date's month; use for monthly trend grouping.
	column YEAR_MONTH
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 926fce62-b126-4e1d-b4f9-4749ac93f57c
		summarizeBy: none
		sourceColumn: YEAR_MONTH

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Quarter number 1-4 within the year.
	column QUARTER_NUMBER
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 11605ecf-b884-4eca-a44a-09bdd87829a1
		summarizeBy: none
		sourceColumn: QUARTER_NUMBER

		annotation SummarizationSetBy = User

