	column QUARTER_NAME
		dataType: string
		lineageTag: 543f59d4-5b7c-4773-b08e-06a3fe077f82
		summarizeBy: none
		sourceColumn: QUARTER_NAME

		annotation SummarizationSetBy = Automatic

	/// Month number 1-12 within the year.
	column MONTH
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 91bcf95c-99aa-4b71-9836-3a270a1c2200
		summarizeBy: none
		sourceColumn: MONTH

		annotation SummarizationSetBy = User

	/// Full month name (January-December).
	column MONTH_NAME
		dataType: string
		lineageTag: 399a8a75-96ab-48c7-9d90-3ce2eba60092
		summarizeBy: none
		sourceColumn: MONTH_NAME
		sortByColumn: MONTH

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	/// Month-year display label (e.g., Dec-2023).
	column MONTH_YEAR
		dataType: dateTime
		formatString: mmm yyyy
