/// BUSINESS MEANING: Standard calendar for all time-based analysis (year, quarter, month, week, day attributes). GRAIN: one row per calendar date (2016-2028). RELATIONSHIPS: the role-playing date dimension; active joins on DATE_KEY to order date (FCT_ORDERS, FCT_ORDER_ITEMS, FCT_ORDER_PAYMENTS), RFM snapshot month (FCT_RFM_SEGMENTS) and cohort month (FCT_COHORT_RETENTION); an inactive join covers order delivery date (activate with USERELATIONSHIP). FCT_CLV_CUSTOMER and FCT_MARKET_BASKET are not date-related.
table DIM_DATES
	lineageTag: b4cf66a4-55c7-458b-be19-6f24ccc2c2e6
	dataCategory: Time

	/// Integer date key in YYYYMMDD; primary key and the join target for fact date columns. Grain: one per calendar date.
	column DATE_KEY
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 0d5e6907-6544-44ed-a468-2be8dda238ef
		isDefaultLabel
		summarizeBy: none
		sourceColumn: DATE_KEY

		annotation SummarizationSetBy = Automatic

	/// Calendar date and default field for time analysis. Grain: one per day.
	column DATE
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: 53a735b5-6978-4f5d-b2c9-e44469b05cbf
		summarizeBy: none
		sourceColumn: DATE

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

